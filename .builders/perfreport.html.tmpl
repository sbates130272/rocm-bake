<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>__TITLE__</title>
<!--
  Inline data URI rather than a favicon.ico beside the page: a run
  directory is copied around - perf-publish ships index.html and the
  sidecar onto gh-pages, perfserve copies them into .current - and a
  separate icon file would have to be copied by every one of those
  paths or 404 on all of them. Three ascending bars, one per builder,
  in slots 1-3 of the chart's own palette. No background, so it reads
  on a light or a dark tab strip.
-->
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2016%2016'%3E%3Crect%20x='2'%20y='9'%20width='3'%20height='5'%20rx='1'%20fill='%232a78d6'/%3E%3Crect%20x='6.5'%20y='5'%20width='3'%20height='9'%20rx='1'%20fill='%23eb6834'/%3E%3Crect%20x='11'%20y='2'%20width='3'%20height='12'%20rx='1'%20fill='%231baf7a'/%3E%3C/svg%3E">
<!--
  Template for .builders/perfreport.py's interactive chart. It lives in
  its own file rather than as a string inside the script for two
  reasons: ruff lints every .py in this repo and embedded CSS/JS blows
  the line-length limit with no way to annotate a noqa inside a string
  literal; and markup is easier to edit as markup. The script
  substitutes __TITLE__, __SUB__, __XLABEL__, __YLABEL__ and __DATA__.
-->
<style>
  :root {
    color-scheme: light dark;
    --surface:#fcfcfb; --ink:#0b0b0b; --ink2:#52514e; --grid:#e4e3df;
  }
  @media (prefers-color-scheme: dark) {
    :root { --surface:#1a1a19; --ink:#f0efec; --ink2:#c3c2b7; --grid:#2e2e2c; }
  }
  body { margin:0; padding:24px; background:var(--surface); color:var(--ink);
    font:14px/1.5 ui-sans-serif,-apple-system,"Segoe UI",Helvetica,Arial,sans-serif; }
  h1 { font-size:17px; margin:0 0 2px; }
  .sub { color:var(--ink2); font-size:12px; margin-bottom:16px; }
  .runsel { font-size:12px; color:var(--ink2); margin:-8px 0 16px; }
  .runsel select { font:inherit; color:var(--ink); background:transparent;
    border:1px solid var(--grid); border-radius:4px; padding:3px 6px;
    margin-left:6px; max-width:420px; }
  .wrap { display:flex; gap:18px; align-items:flex-start; }
  .plot { flex:1 1 auto; min-width:0; }
  /* Legend on the right, and it is also the filter: clicking a row
     toggles that series. A hidden series keeps its colour slot, so
     colour follows the builder rather than its position in the
     surviving set. */
  .legend { flex:0 0 auto; width:236px; padding-top:2px; }
  .legend h2 { font-size:11px; text-transform:uppercase; letter-spacing:.06em;
    color:var(--ink2); margin:12px 0 2px 6px; font-weight:600; }
  .legend .dur { margin-left:auto; color:var(--ink2); font-size:11px;
    font-variant-numeric:tabular-nums; }
  .legend button { display:flex; align-items:center; gap:9px; width:100%;
    background:none; border:0; padding:7px 6px; cursor:pointer; color:var(--ink);
    font:inherit; text-align:left; border-radius:6px; }
  .legend button:hover { background:color-mix(in srgb, var(--ink) 7%, transparent); }
  .legend button[aria-pressed="false"] { opacity:.42; }
  .legend .sw { width:11px; height:11px; border-radius:3px; flex:0 0 auto; }
  .legend .val { margin-left:auto; color:var(--ink2); font-size:12px;
    font-variant-numeric:tabular-nums; }
  .hint { color:var(--ink2); font-size:11px; margin-top:10px; }
  svg { display:block; width:100%; height:auto; }
  .gridline { stroke:var(--grid); stroke-width:1; }
  .axis { fill:var(--ink2); font-size:11px; }
  .axlbl { fill:var(--ink2); font-size:12px; font-weight:600; }
  .ln { fill:none; stroke-width:2; stroke-linejoin:round; stroke-linecap:round; }
  .band { opacity:.9; }
  .bandlbl { fill:var(--surface); font-size:10px; pointer-events:none; }
  .cross { stroke:var(--ink2); stroke-width:1; stroke-dasharray:3 3; }
  /* Per-band tooltip. The bands are the part that says what the node
     was doing; without this they can say "compile" and nothing more. */
  #tip { position:fixed; z-index:10; max-width:560px; display:none;
    background:var(--surface); color:var(--ink); border:1px solid var(--grid);
    border-radius:8px; padding:10px 12px; font-size:12px; line-height:1.45;
    box-shadow:0 6px 24px rgba(0,0,0,.18); pointer-events:none; }
  #tip .hd { font-weight:600; margin-bottom:5px; }
  #tip .mt { color:var(--ink2); margin-bottom:6px; }
  #tip code { display:block; white-space:pre-wrap; word-break:break-word;
    font:11px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;
    color:var(--ink2); margin:3px 0 0; }
  .band { cursor:default; }
  .band:hover { stroke:var(--ink); stroke-width:1.5; }
  table { border-collapse:collapse; margin-top:22px; font-size:12px; }
  th,td { border:1px solid var(--grid); padding:5px 10px; text-align:left; }
  th { color:var(--ink2); font-weight:600; }
  td.n { text-align:right; font-variant-numeric:tabular-nums; }
</style></head><body>
<h1>__TITLE__</h1>
<div class="sub">__SUB__ &middot; <span id="live">live</span></div>
<div class="runsel" id="runsel" hidden><label for="run">run</label><select id="run"></select></div>
<div id="tip"></div>
<div class="wrap">
  <div class="plot" id="plot"></div>
  <div class="legend" id="legend"></div>
</div>
<div class="hint">
  Click a builder to show/hide its CPU line, or a target to show/hide its
  band. Hover the plot for values at that moment.
</div>
<table id="tbl"><thead><tr>
  <th>target</th><th>builder</th><th>start</th><th>duration</th><th>phases</th>
</tr></thead><tbody></tbody></table>
<script>
const DATA = __DATA__;
const W=900,PL=120,PR=18,PT=14,PB=66;
const SH=Math.max(34,(DATA.targets||[]).length*13+8);
const H=320+SH;
const pw=W-PL-PR, ph=H-PT-PB-SH;
const hidden=new Set();
const hiddenT=new Set();
const hiddenM=new Set();
const xmax=DATA.xmax||1, ymax=DATA.ymax||100;
const X=t=>PL+pw*Math.max(0,Math.min(t,xmax))/xmax;
const Y=v=>PT+ph*(1-Math.max(0,Math.min(v,ymax))/ymax);

function draw(){
  // Ticks in seconds, to agree with the axis label. A mixed
  // "5m00s" tick under an axis labelled (s) reads as a unit error.
  const tick = xmax>2400?600 : xmax>1200?300 : xmax>600?120 : 60;
  let g="";
  for(let f=0;f<=1.001;f+=0.25){
    const y=Y(ymax*f);
    g+=`<line class="gridline" x1="${PL}" y1="${y}" x2="${PL+pw}" y2="${y}"/>`
      +`<text class="axis" x="${PL-9}" y="${y+4}" text-anchor="end">`
      +`${Math.round(ymax*f)}${DATA.unit}</text>`;
  }
  for(let t=0;t<=xmax;t+=tick){
    const x=X(t);
    g+=`<line class="gridline" x1="${x}" y1="${PT}" x2="${x}" `
      +`y2="${PT+ph+SH}" opacity=".5"/>`
      +`<text class="axis" x="${x}" y="${H-44}" text-anchor="middle">`
      +`${Math.round(t)}</text>`;
  }
  g+=`<text class="axlbl" x="${PL+pw/2}" y="${H-18}" `
    +`text-anchor="middle">__XLABEL__</text>`;
  g+=`<text class="axlbl" transform="translate(16,${PT+ph/2}) rotate(-90)" `
    +`text-anchor="middle">__YLABEL__</text>`;

  // One row per visible target. The row is what says "this is
  // vllm-wheel"; the phases inside it say what vllm-wheel was doing.
  // Grouping by builder instead hid which target a band belonged to
  // whenever a node ran more than one across the run.
  let row=0;
  for(const t of DATA.targets){
    if(hiddenT.has(t.name)) continue;
    if(hidden.has(t.builder)) continue;
    const y0=PT+ph+6+row*13;
    for(const b of t.bands){
      const x0=X(b.start);
      const bw=Math.max(2,X(b.start+b.dur)-x0);
      // An in-flight target is drawn hollow: it has a start and no
      // end yet, and filling it would claim a duration it does not
      // have.
      const live = t.running
        ? ` fill="none" stroke="${t.color}" stroke-width="1.5" stroke-dasharray="4 3"`
        : ` fill="${t.color}"`;
      g+=`<rect class="band" x="${x0}" y="${y0}" width="${bw}" `
        +`height="11" rx="2"${live} `
        +`data-t="${t.id}" data-b="${t.bands.indexOf(b)}"/>`;
      if(bw>44) g+=`<text class="bandlbl" x="${x0+4}" `
        +`y="${y0+8.5}">${b.label}</text>`;
    }
    g+=`<text class="axis" x="${X(t.start)-6}" y="${y0+9}" `
      +`text-anchor="end">${t.name}</text>`;
    row++;
  }
  for(const s of DATA.series){
    if(hidden.has(s.name)) continue;
    if(hiddenM.has(s.metric)) continue;
    const d=s.points.map((p,i)=>
      `${i?"L":"M"}${X(p[0]).toFixed(1)},${Y(p[1]).toFixed(1)}`).join(" ");
    // Metric by line style, builder by colour. Colour stays with the
    // entity; a second encoding carries the second dimension, rather
    // than inventing six hues for three machines.
    const dash=s.dash?` stroke-dasharray="${s.dash}"`:"";
    g+=`<path class="ln" d="${d}" stroke="${s.color}"${dash}/>`;
  }
  g+=`<line id="cx" class="cross" x1="0" y1="${PT}" x2="0" `
    +`y2="${PT+ph}" style="display:none"/>`;
  document.getElementById("plot").innerHTML=
    `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="__TITLE__">${g}</svg>`;

  const svg=document.querySelector("#plot svg");
  svg.addEventListener("pointermove",e=>{
    const r=svg.getBoundingClientRect();
    const x=(e.clientX-r.left)*(W/r.width);
    if(x<PL||x>PL+pw){clear();return;}
    const t=(x-PL)/pw*xmax;
    const c=document.getElementById("cx");
    c.setAttribute("x1",x); c.setAttribute("x2",x); c.style.display="";
    for(const s of DATA.series){
      const el=document.getElementById("v-"+s.id);
      if(!el) continue;
      if(hidden.has(s.name)||hiddenM.has(s.metric)){el.textContent="";continue;}
      let best=null,bd=1e9;
      for(const p of s.points){
        const d=Math.abs(p[0]-t);
        if(d<bd){bd=d;best=p;}
      }
      el.textContent=best?best[1].toFixed(1)+DATA.unit:"";
    }
    document.getElementById("at").textContent="at "+Math.round(t)+"s";
  });
  svg.addEventListener("pointerleave",()=>{clear();hideTip();});

  // Band tooltips. Delegated rather than per-rect listeners: a long
  // run can draw hundreds of bands and they are redrawn on every
  // toggle, so binding each one leaks handlers.
  const tip=document.getElementById("tip");
  svg.addEventListener("pointerover",e=>{
    const r=e.target.closest(".band"); if(!r){hideTip();return;}
    const t=DATA.targets.find(x=>x.id===r.dataset.t);
    if(!t) return;
    const b=t.bands[+r.dataset.b]; if(!b) return;
    const pct=(100*b.dur/(DATA.xmax||1)).toFixed(1);
    tip.innerHTML=
      `<div class="hd">${t.name} &middot; ${b.phase}</div>`
      +`<div class="mt">${t.builder} &middot; starts ${Math.round(b.start)}s `
      +`&middot; ${dur(b.dur)} (${pct}% of run) &middot; `
      +`${b.steps.length} step${b.steps.length===1?"":"s"}</div>`
      + b.steps.map(st=>
          `<code>${dur(st.dur).padStart(6)}  ${esc(st.cmd)}</code>`).join("");
    tip.style.display="block";
    place(e);
  });
  svg.addEventListener("pointermove",e=>{ if(tip.style.display==="block") place(e); });
  function place(e){
    const pad=14, w=tip.offsetWidth, h=tip.offsetHeight;
    let x=e.clientX+pad, y=e.clientY+pad;
    if(x+w>innerWidth-8) x=e.clientX-w-pad;
    if(y+h>innerHeight-8) y=Math.max(8,e.clientY-h-pad);
    tip.style.left=x+"px"; tip.style.top=y+"px";
  }
  function hideTip(){ tip.style.display="none"; }
}

function clear(){
  const c=document.getElementById("cx");
  if(c) c.style.display="none";
  // Guarded like the two other lookups of this id, and for the same
  // reason: legend() only creates a v-<id> span for the FIRST metric,
  // so every series of the second one resolves to null here. Without
  // the guard this threw on the first memory series, and being
  // uncaught at top level it halted the script — taking the run
  // selector's init and setInterval(poll) with it. Live refresh had
  // been dead since the day memory became a second metric, silently,
  // because the chart itself draws before this runs.
  for(const s of DATA.series){
    const el=document.getElementById("v-"+s.id);
    if(el) el.textContent=s.peak.toFixed(1)+DATA.unit;
  }
  const at=document.getElementById("at");
  if(at) at.textContent="peak";
}

const esc=t=>String(t).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
const dur=s=>{s=Math.round(s);return s<60?s+"s":
  Math.floor(s/60)+"m"+String(s%60).padStart(2,"0")+"s";};

function legend(){
  document.getElementById("legend").innerHTML=
    `<div class="hint" id="at" style="margin:0 0 2px 6px">peak</div>`
    +`<h2>Builders</h2>`
    + DATA.series.filter(s=>s.metric===(DATA.metrics||["cpu"])[0]).map(s=>
      `<button aria-pressed="true" data-k="b" data-n="${s.name}">`
      +`<span class="sw" style="background:${s.color}"></span>`
      +`<span>${s.name}</span>`
      +`<span class="val" id="v-${s.id}">`
      +`${s.peak.toFixed(1)}${DATA.unit}</span></button>`).join("")
    +`<h2>Metrics</h2>`
    + (DATA.metrics||["cpu"]).map((m,i)=>
      `<button aria-pressed="true" data-k="m" data-n="${m}">`
      +`<span class="sw" style="background:var(--ink2);`
      +`${i?"border-top:2px dashed var(--surface);":""}"></span>`
      +`<span>${m}${i?" (dashed)":""}</span></button>`).join("")
    +`<h2>Targets</h2>`
    + DATA.targets.map(t=>
      `<button aria-pressed="true" data-k="t" data-n="${t.name}">`
      +`<span class="sw" style="background:${t.color}"></span>`
      +`<span>${t.name}</span>`
      +`<span class="dur">${dur(t.dur)}</span></button>`).join("");
  for(const b of document.querySelectorAll(".legend button"))
    b.onclick=()=>{
      const n=b.dataset.n;
      const set=b.dataset.k==="t"?hiddenT:(b.dataset.k==="m"?hiddenM:hidden);
      if(set.has(n)){set.delete(n);b.setAttribute("aria-pressed","true");}
      else{set.add(n);b.setAttribute("aria-pressed","false");}
      draw();
    };
}

function clearAll(){
  for(const s of DATA.series){
    const el=document.getElementById("v-"+s.id);
    if(el) el.textContent=s.peak.toFixed(1)+DATA.unit;
  }
}
document.querySelector("#tbl tbody").innerHTML=DATA.targets.map(t=>
  `<tr><td>${t.name}</td><td>${t.builder}</td>`
  +`<td class="n">${Math.round(t.start)}s</td>`
  +`<td class="n">${dur(t.dur)}</td>`
  +`<td>${t.bands.map(b=>b.label).join(", ")}</td></tr>`).join("");
legend(); draw(); clear();

// Live refresh: poll the sidecar, not the page. Reloading would reset
// the legend filters, and the filters are the point - someone with
// two builders hidden is mid-question. A redraw keeps `hidden` and
// `hiddenT` and only the series data changes underneath.
const REFRESH_MS = 20000;
let stamp = null;

// Run selector. Progressive enhancement: perfserve.sh publishes
// runs.json and a runs/<stamp>.json beside the live data.json. Served
// straight out of a run directory instead - perf-publish on gh-pages,
// or opening the file - those fetches 404, the selector stays hidden
// and the page behaves exactly as it did before.
let RUNS = [];
let viewing = null;     // stamp on screen; always RUNS[0] until chosen

// Live only while the newest run is the one being shown. Polling an
// archived run would overwrite it with the live one every 20s, which
// is the whole bug this guard exists to prevent.
function isLive(){ return !RUNS.length || viewing === RUNS[0].stamp; }

function applyData(d){
  DATA.series = d.series; DATA.targets = d.targets;
  DATA.xmax = d.xmax; DATA.ymax = d.ymax;
  legend(); draw(); clear();
}

function setStatus(){
  const el = document.getElementById("live");
  if (!el) return;
  el.textContent = isLive()
    ? "updated " + new Date().toLocaleTimeString()
    : "archived run";
}

// The newest run is read from data.json, not runs/<stamp>.json: it is
// the one perfserve rewrites in place, so the sidecar is fresher than
// the per-run copy for however long the run has left.
async function loadRun(sel){
  try {
    const live = !RUNS.length || sel === RUNS[0].stamp;
    const url = live ? "data.json"
                     : "runs/" + encodeURIComponent(sel) + ".json";
    const r = await fetch(url, {cache: "no-store"});
    if (!r.ok) return;
    applyData(await r.json());
    viewing = sel;
    stamp = null;                      // force the next poll to redraw
    setStatus();
  } catch (e) { /* leave the current view alone */ }
}

function fillSelector(){
  const box = document.getElementById("runsel");
  const sel = document.getElementById("run");
  if (!box || !sel || RUNS.length < 2) return;
  sel.textContent = "";
  for (const run of RUNS){
    const o = document.createElement("option");
    o.value = run.stamp;
    o.textContent = run.label || run.stamp;
    sel.appendChild(o);
  }
  sel.value = viewing;
  box.hidden = false;
}

async function refreshRuns(){
  try {
    const r = await fetch("runs.json", {cache: "no-store"});
    if (!r.ok) return false;
    const next = await r.json();
    if (!Array.isArray(next) || !next.length) return false;
    const wasNewest = !RUNS.length || viewing === RUNS[0].stamp;
    const changed = RUNS.length !== next.length
      || next.some((r2, i) => !RUNS[i] || r2.stamp !== RUNS[i].stamp);
    RUNS = next;
    // A run that starts while the page is open becomes the newest, and
    // someone watching the newest wants to follow it - that is what
    // this page is for. Someone reading an archived run does not.
    if (wasNewest) viewing = RUNS[0].stamp;
    if (changed) fillSelector();
    const sel = document.getElementById("run");
    if (sel && sel.value !== viewing) sel.value = viewing;
    return wasNewest && changed;
  } catch (e) { return false; }
}

async function poll(){
  const followed = await refreshRuns();
  if (followed) { await loadRun(viewing); return; }
  if (!isLive()) return;               // archived: nothing to poll
  try {
    const r = await fetch("data.json", {cache: "no-store"});
    if (!r.ok) return;
    const d = await r.json();
    const sig = JSON.stringify([d.xmax, d.series.map(s=>s.points.length),
                                d.targets.map(t=>t.name)]);
    if (sig === stamp) return;          // nothing new; leave the DOM alone
    stamp = sig;
    applyData(d);
    setStatus();
  } catch (e) { /* server restarting mid-regeneration; try again */ }
}

(async function initRuns(){
  if (!(await refreshRuns())) {
    // No runs.json, or no change: either way settle on the newest.
    if (RUNS.length) { viewing = RUNS[0].stamp; fillSelector(); }
  }
  const sel = document.getElementById("run");
  if (sel) sel.addEventListener("change", () => loadRun(sel.value));
})();

setInterval(poll, REFRESH_MS);
</script></body></html>
