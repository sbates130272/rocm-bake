# syntax=docker/dockerfile:1
# Minimal PyTorch ROCm runtime image for gfx950
# Receives pre-built PyTorch wheel from pytorch target context

ARG PYTHON_VERSION=3.14
ARG ROCM_VERSION=10.1.0-full

# rocm/rocm:rocm_ubuntu24.04_* does not exist — that reference was
# speculative and 503s through the mirror. AMD publishes only
# dev-ubuntu-26.04:10.1.0-full for this ROCm; there is no -runtime or
# -base variant, so this image is not as small as "minimal runtime"
# suggests. Trimming it properly means installing just the ROCm runtime
# packages onto plain ubuntu rather than taking the full SDK.
ARG RUNTIME_BASE_IMAGE=rocm/dev-ubuntu-26.04:${ROCM_VERSION}
FROM ${RUNTIME_BASE_IMAGE} AS base

# Re-declared inside the stage. ARGs before the first FROM live in the
# global scope only, so without these every ${PYTHON_VERSION} below
# expands to the empty string and apt is asked for `python`.
ARG PYTHON_VERSION
ARG ROCM_VERSION

LABEL org.opencontainers.image.source="https://github.com/sbates130272/rocm-pytorch-build"
LABEL org.opencontainers.image.description="Minimal PyTorch ROCm runtime for gfx950"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install Python and minimal runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-venv \
    libsndfile1 \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create venv
RUN python${PYTHON_VERSION} -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel

ENV PATH=/opt/venv/bin:$PATH

# PyTorch build context - the wheel is copied from the pytorch build image
# In rocm-bake.hcl, contexts = { pytorch = "${REGISTRY}/${REGISTRY_NAME}/pytorch:..." }
# The wheel path is /opt/venv/lib/python3.x/site-packages/ inside the pytorch image
FROM base AS runtime

COPY --from=pytorch /opt/venv/lib/python${PYTHON_VERSION}/site-packages/ \
    /opt/venv/lib/python${PYTHON_VERSION}/site-packages/

# ROCm environment
ENV ROCM_PATH=/opt/rocm
ENV PATH=${ROCM_PATH}/bin:${ROCM_PATH}/hip/bin:${PATH}
ENV LD_LIBRARY_PATH=${ROCM_PATH}/lib:/opt/rocm/lib
# No HSA_OVERRIDE_GFX_VERSION. It used to be pinned to 11.0.2 here,
# which tells HSA to treat whatever GPU it finds as gfx1102 (RDNA3).
# That is a workaround for running on a GPU with no native support, and
# it is actively harmful everywhere else: on a real gfx1201 it made HSA
# fail at init with "HSA_STATUS_ERROR_OUT_OF_RESOURCES" and
# hipGetDeviceCount returning hipErrorNoDevice, so torch saw no device
# at all. Removing it, the same image reports
# "AMD Radeon RX 9070 XT gfx1201" and runs a correct matmul.
#
# If a specific host ever needs the override, set it per-run
# (docker run -e HSA_OVERRIDE_GFX_VERSION=...) rather than baking it
# into every image.

# Verify the import only. torch.cuda.is_available() is false inside a
# buildkit RUN — there is no /dev/kfd — so asserting on it here could
# never pass; that check belongs in `make test` against a real GPU.
RUN python -c "import torch; print(f'PyTorch {torch.__version__} (HIP {torch.version.hip})')"

CMD ["-c", "import torch; print(f'PyTorch {torch.__version__} on {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"no GPU\"}'); exit(0 if torch.cuda.is_available() else 1)"]
