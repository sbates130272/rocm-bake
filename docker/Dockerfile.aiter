# syntax=docker/dockerfile:1
# AITER (github.com/ROCm/aiter) built as a standalone wheel.
#
# AITER is NOT built by PyTorch. The pytorch tree carries a
# third_party/aiter submodule, but nothing in the PyTorch build reads
# USE_AITER — it is a separate package with its own setup.py.
#
# It does need torch at build time: its setup.py imports torch, and its
# own requirements note that "torch and triton are provided by the base
# image as ROCm-specific builds ... not published on PyPI". So this
# builds FROM our PyTorch image rather than from the ROCm base, which
# means it runs after the pytorch target rather than alongside it. It is
# still independent of the runtime image, so it can run on a different
# node concurrently with other post-PyTorch work.
#
# The result is a thin image whose only payload is /wheels/*.whl. That
# is how the wheel gets into Zot: an OCI image is something buildx can
# push and `contexts` can consume, with no extra tooling (ORAS, a PyPI
# index) and no second artifact store to keep alive.

ARG PYTORCH_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/pytorch:latest
ARG TRITON_WHEEL_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/triton-wheel:latest

# Our ROCm 10.1 triton, as a wheelhouse for AITER's installer.
FROM ${TRITON_WHEEL_IMAGE} AS tritonwheels

FROM ${PYTORCH_IMAGE} AS builder

ARG AITER_REF=main
ARG PYTORCH_ROCM_ARCH=gfx950
ARG SCCACHE_WEBDAV_ENDPOINT=http://snoc-strix.fold-leaffish.ts.net:8081
# Namespace this project's objects. The store is shared with other
# projects on the same fleet, and while sccache's keys are content
# hashes (so sharing is normally safe and desirable), entries written
# while two containers' sccache servers were crossed over a host port
# were wrong — a triton build hit them and died with "stdlib.h: No such
# file or directory" on a system that compiles that header fine. Proven
# by rebuilding under an isolated prefix: zero such errors.
#
# The crossing itself is fixed by SCCACHE_SERVER_UDS above, so this
# prefix is about abandoning the already-poisoned entries without
# deleting a store other projects are still using, and about bounding
# the blast radius if it ever recurs.
ARG SCCACHE_WEBDAV_KEY_PREFIX=rocm-pytorch
# A unix socket, not a TCP port. The builders run with
# --driver-opt network=host, so SCCACHE_SERVER_PORT is shared by every
# container on the node. A concurrent vLLM build on snoc-strix held
# 4250, our triton client connected to *its* sccache server, and that
# server could not see /opt/triton in its own mount namespace:
#
#   sccache: error: failed to spawn Command { cd "/opt/triton/build/..."
#   sccache: caused by: No such file or directory (os error 2)
#
# Same root cause as the long-settled "one shared sccache server is
# impossible" finding: the server compiles from its own filesystem. A
# socket inside the container cannot be reached by another container,
# so each build necessarily gets its own server.
# 0 (upstream default) compiles nothing at package time — kernels are
# JIT-built on first use, which is why this target finished in 49s and
# barely touched sccache. The levels, from setup.py's get_exclude_ops():
#
#   1  excludes _tune, and limits MHA to the fmha_v3 forward variants
#   2  excludes _bwd and _tune
#   3  keeps only module_fmha_v3*
#
# 2 because _bwd is the backward pass — training, not inference, which
# is all this fleet serves. At level 1 a complete build took 144
# minutes: ~49 in FlyDSL AOT, ~89 building CK modules, 5 exporting the
# layer cache. The module phase was dominated by five GEMM modules
# costing 202 minutes of overlapping compile, so dropping the backward
# variants cuts work we would never dispatch. Raise it to 1 if anything here is ever trained
# on, and remember the compiler cache carries over either way: level 2
# builds a subset of level 1's compiles, so its objects are already
# populated.
#
# GPU_ARCHS below is what makes this safe in a build container: without
# it AITER falls back to "native" and shells out to rocminfo, which
# finds no device and raises.
ARG PREBUILD_KERNELS=2

# Empty means derive from the node; set it to pin a job count.
ARG MAX_JOBS=
# AITER's kernel compiles are far lighter than cc1plus: measured 4.178GB
# across 12 jobs on snoc-strix, about 357MB each. The 2GB default used
# for pytorch and triton would cap this node at 12 of its 32 cores for
# no reason, and this is the most expensive target in the pipeline. 1GB
# keeps roughly 3x headroom over what was measured.
ARG MEM_PER_JOB_GB=1

LABEL org.opencontainers.image.source="https://github.com/ROCm/aiter"
LABEL org.opencontainers.image.description="AITER wheel for ${PYTORCH_ROCM_ARCH}"

ENV PREBUILD_KERNELS=${PREBUILD_KERNELS} \
    PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH} \
    GPU_ARCHS=${PYTORCH_ROCM_ARCH} \
    ROCM_PATH=/opt/rocm \
    SCCACHE_WEBDAV_ENDPOINT=${SCCACHE_WEBDAV_ENDPOINT} \
    SCCACHE_SERVER_UDS=/tmp/sccache.sock \
    SCCACHE_WEBDAV_KEY_PREFIX=${SCCACHE_WEBDAV_KEY_PREFIX} \
    SCCACHE_IGNORE_CLIENT_VERSION=1 \
    SCCACHE_CONF=/etc/sccache.toml \
    CMAKE_C_COMPILER_LAUNCHER=sccache \
    CMAKE_CXX_COMPILER_LAUNCHER=sccache \
    CMAKE_HIP_COMPILER_LAUNCHER=sccache \
    CMAKE_POLICY_VERSION_MINIMUM=3.5

# hipcc's own launcher hook, which is the only way AITER's compiles
# reach sccache. CMAKE_*_COMPILER_LAUNCHER does nothing here: AITER's
# JIT builds never invoke CMake. They use a vendored copy of PyTorch's
# cpp_extension, which writes a ninja file calling the compiler by
# absolute path:
#
#   nvcc = [_join_rocm_home("bin", "hipcc")]
#
# so there is no launcher for CMake to insert. Measured consequence:
# a 2.5-hour AITER build sent zero requests to the cache server.
#
# hipcc reads HIP_CLANG_LAUNCHER and prefixes its clang invocation with
# it. Verified on this image: two identical hipcc compiles give one
# miss then one hit, classified HIP, with the ROCm install untouched —
# unlike wrapping hipcc itself, which broke its self-location and
# produced "HIP version file not found".
ENV HIP_CLANG_LAUNCHER=/usr/local/bin/sccache

# sccache lives in Dockerfile.pytorch's *builder* stage and never
# reaches `final`, which is what this image is FROM. Without it the
# CMAKE_*_COMPILER_LAUNCHER settings above point at a missing binary and
# the stats call at the end of the build step fails a build whose wheel
# was produced successfully.
ARG SCCACHE_VERSION=0.19.0
# Pinned by content, not just by version tag: a release asset can be
# replaced after publication, and this binary wraps every compile in
# the pipeline. ADD --checksum fails the build on mismatch, where curl
# would happily install whatever it was served.
ARG SCCACHE_SHA256=aa73c7270c997894038c0d8f0d297865f57569e1687883322bc431713d4bb9dd
ADD --checksum=sha256:${SCCACHE_SHA256} \
    "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    /tmp/sccache.tar.gz
RUN tar xzf /tmp/sccache.tar.gz -C /usr/local/bin --strip-components=1 \
        "sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache" && \
    rm /tmp/sccache.tar.gz && chmod +x /usr/local/bin/sccache && sccache --version

# Each RUN is a fresh container, so a build step has to start its own
# sccache server, and startup probes the remote store. That probe is
# bounded by a 10s timeout compiled into sccache — no environment
# variable exists for it, only this config file field. Under load on the
# node hosting the cache, 10s was not enough and the build died with
# "Timed out waiting for server startup". The backend stays configured
# by environment; this file carries only the timeout.
RUN printf 'server_startup_timeout_ms = 60000\n' > /etc/sccache.toml

# AITER's extensions are HIP, so the submodules under 3rdparty are not
# optional any more than PyTorch's are.
RUN git clone --depth 1 --branch ${AITER_REF} --recurse-submodules \
    --shallow-submodules \
    https://github.com/ROCm/aiter.git /opt/aiter

WORKDIR /opt/aiter

# AITER's setup.py runs .github/scripts/install_triton.sh, which
# uninstalls whatever triton is present and installs one from AMD's
# index. That index publishes nothing newer than ROCm 7.2, so against
# our ROCm 10.1 torch it produces a three-major mismatch.
#
# The script checks TRITON_WHEEL_DIR first and only falls back to the
# public index if that fails — but it needs BOTH triton and
# triton-kernels present, hence Dockerfile.triton building both.
COPY --from=tritonwheels /wheels/ /opt/triton-wheels/
ENV TRITON_WHEEL_DIR=/opt/triton-wheels
RUN ls -la /opt/triton-wheels/

# --no-isolation means pip will NOT fetch the build backend's own
# dependencies, so everything in [build-system].requires has to be
# installed first. Read them out of pyproject.toml rather than hardcoding:
# the list differs between AITER releases (v0.1.27 adds vcs_versioning on
# top of main's setuptools_scm, pybind11, ninja, pandas, flydsl...).
#
# flydsl appears in that list, which is also the whole story on "FlyDSL":
# it is a PyPI build dependency of AITER, not a PyTorch build option.
RUN python -c "import tomllib; print(chr(10).join(tomllib.load(open('pyproject.toml','rb'))['build-system']['requires']))" \
        > /tmp/build-reqs.txt && \
    echo "--- AITER build-system requires ---" && cat /tmp/build-reqs.txt && \
    pip install --no-cache-dir -r /tmp/build-reqs.txt && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir 'setuptools-scm<10'

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# `setup.py bdist_wheel`, not `python -m build`, because that is what
# AITER's own release CI runs — .github/workflows/aiter-release.yaml:
#
#   docker exec -e PREBUILD_KERNELS=1 -e GPU_ARCHS="..." \
#     bash -c "python3 setup.py bdist_wheel && ls dist/*.whl"
#
# The distinction is not cosmetic. PEP 517 calls
# get_requires_for_build_wheel first, and in that metadata phase
# setup.py skips the branch that puts aiter/ on sys.path and binds
# `core`:
#
#   if not _is_metadata_only() and not AITER_TRITON_ONLY:
#       sys.path.insert(0, os.path.join(this_dir, "aiter"))
#       from jit import core
#
# but the PREBUILD_KERNELS block further down is not guarded by the
# same condition and runs anyway, because torch is installed here. That
# gave "ModuleNotFoundError: No module named 'jit'", and once PYTHONPATH
# fixed the import, "NameError: name 'core' is not defined" behind it.
# setup.py bdist_wheel never enters that phase, so neither happens.
#
# Upstream also builds GPU-less when the runner has no /dev/kfd, which
# is our case: they pass the device flags conditionally and keep
# PREBUILD_KERNELS=1 either way. GPU_ARCHS is what keeps setup.py from
# shelling out to rocminfo to detect the target.
RUN if [ -z "${MAX_JOBS}" ]; then \
        cores=$(nproc); \
        jobs=$(awk -v per="${MEM_PER_JOB_GB}" '/^MemAvailable:/ {print int($2/1024/1024/per)}' /proc/meminfo); \
        [ -n "${jobs}" ] || jobs=${cores}; \
        [ "${jobs}" -ge 1 ] || jobs=1; \
        [ "${jobs}" -le "${cores}" ] || jobs=${cores}; \
        export MAX_JOBS=${jobs}; \
        echo "MAX_JOBS=${MAX_JOBS} (from ${cores} cores, $(awk '/^MemAvailable:/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) available, ${MEM_PER_JOB_GB}GB/job)"; \
    else \
        echo "MAX_JOBS=${MAX_JOBS} (pinned via build arg)"; \
    fi; \
    python setup.py bdist_wheel --dist-dir=/wheels \
    2>&1 | tee /wheels-build.log \
    && sccache --show-stats | tee /wheels-aiter-sccache-stats.txt

SHELL ["/bin/sh", "-c"]

RUN ls -la /wheels/

# ─── Wheel-only image ────────────────────────────────────────────
# scratch, not the PyTorch image: this exists to be consumed by
# `COPY --from=`, so it should carry the wheel and nothing else.
FROM scratch AS wheel

ARG PYTORCH_ROCM_ARCH
LABEL org.opencontainers.image.source="https://github.com/ROCm/aiter"
LABEL org.opencontainers.image.description="AITER wheel for ${PYTORCH_ROCM_ARCH}"

COPY --from=builder /wheels/ /wheels/
COPY --from=builder /wheels-build.log /wheels-aiter-sccache-stats.txt /
