# syntax=docker/dockerfile:1
# vLLM on CPU: real weights, a real forward pass, no GPU.
#
# The lane between the other two. Dockerfile.vllm needs a card;
# Dockerfile.vllm-emu needs none but loads no model and emits filler.
# This builds vLLM with VLLM_TARGET_DEVICE=cpu on a CPU torch, so a
# small model serves real tokens on any x86 box with AVX2 — a stock CI
# runner included. It checks what emu cannot (model loading, output
# correctness, KV blocks moving through LMCache) and says nothing about
# device latency. No ROCm, NIXL, CuPy, AITER or ATOM in this file. See
# docs/architecture/cpu.md.
#
# manylinux for the reason Dockerfile.vllm-emu gives. Here the base
# does earn the tag: the wheel carries five extensions and repairs to
# manylinux_2_27.

ARG MANYLINUX_IMAGE=quay.io/pypa/manylinux_2_28_x86_64:2026.11.14-1
ARG PYTHON_VERSION=3.14
ARG LMCACHE_WHEEL_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/lmcache-cpu-wheel:latest

FROM ${LMCACHE_WHEEL_IMAGE} AS lmcachewheels

# ─── vLLM, built for the CPU ─────────────────────────────────────
FROM ${MANYLINUX_IMAGE} AS builder

ARG PYTHON_VERSION
ARG VLLM_REF=v0.34.0
ARG PYTORCH_VERSION
ARG MAX_JOBS=
# The largest single cc1plus measured was 2.7GB (csrc/cpu/cpu_attn.cpp,
# compiled once per ISA variant).
ARG MEM_PER_JOB_GB=3
# Memory the derivation does not hand out, and a hard ceiling on the
# job count. Passed to docker/max-jobs.sh, whose header explains why
# both exist and why neither is a measurement.
ARG MEM_RESERVE_GB=12
ARG MAX_JOBS_CEILING=8
ARG SOURCE_DATE_EPOCH

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONUNBUFFERED=1

# csrc/cpu/utils.cpp includes <numa.h> and every _C variant links
# libnuma. Unpinned: the base floats with manylinux's :latest and
# AlmaLinux serves exactly one build of the package.
# hadolint ignore=DL3041
RUN dnf install -y numactl-devel && dnf clean all

# Interpreter selection as in Dockerfile.vllm-emu: cp314 from 3.14.
RUN set -eu; \
    tag="cp$(echo "${PYTHON_VERSION}" | tr -d '.')"; \
    test -x "/opt/python/${tag}-${tag}/bin/python" \
        || { echo "no ${tag} interpreter in this manylinux image" >&2; \
             ls /opt/python >&2; exit 1; }; \
    ln -s "/opt/python/${tag}-${tag}/bin" /usr/local/pybin
ENV PATH=/usr/local/pybin:$PATH

# No rustup, unlike Dockerfile.vllm-emu. setup.py imports
# setuptools_rust, so the package stays, but with no rustc on PATH the
# optional vllm-rs frontend is skipped at once. With a toolchain it is
# skipped too — by vendored OpenSSL failing to configure for want of
# two perl modules, which a base-image update could silently fix,
# adding a 60MB binary and raising the tag to manylinux_2_28.
RUN pip install --no-cache-dir \
        "cmake>=3.26.1" ninja "packaging>=24.2" \
        "setuptools>=78.1.1,<81.0.0" "setuptools-scm>=8" \
        "setuptools-rust>=1.9.0" "wheel>=0.40" "jinja2>=3.1.6" auditwheel

RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==${PYTORCH_VERSION}" && \
    python -c "import torch; assert not torch.version.hip and not torch.version.cuda, \
        'this lane must build against a CPU torch'; print('torch', torch.__version__)"

RUN git clone --depth 1 --branch ${VLLM_REF} \
    https://github.com/vllm-project/vllm.git /opt/vllm

WORKDIR /opt/vllm

# requirements/cpu.txt becomes the wheel's Requires-Dist verbatim, and
# it pins the torch upstream built against, not ours. The grep fails
# the build if upstream reshapes the line and the sed matches nothing.
# Everything else stays as upstream has it, the triton-cpu direct URL
# included.
RUN set -eu; \
    cp requirements/cpu.txt /tmp/cpu.txt.orig; \
    sed -i -E "s/^torch==[0-9.]+(\+cpu)?;/torch==${PYTORCH_VERSION}\1;/" \
        requirements/cpu.txt; \
    diff /tmp/cpu.txt.orig requirements/cpu.txt || true; \
    grep -q "^torch==${PYTORCH_VERSION}+cpu;" requirements/cpu.txt

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# setup.py directly and a pretended version, both for the reasons
# Dockerfile.vllm-emu gives; njobs by Dockerfile.vllm's convention.
# Release, because setup.py defaults to RelWithDebInfo and the wheel
# comes out 139MB instead of 39MB.
#
# No ISA switch exists at this ref. The x86 build always produces _C
# (AVX512+BF16+VNNI+AMX), _C_AVX512 and _C_AVX2 with fixed flags and
# picks one at runtime from CPUID; nothing is -march=native. The `+cpu`
# suffix setup.py appends is kept, because it is how vLLM selects
# CpuPlatform.
RUN --mount=type=bind,source=docker/max-jobs.sh,target=/max-jobs.sh \
    set -eu; \
    njobs="${MAX_JOBS}"; \
    [ -n "${njobs}" ] || njobs="$(sh /max-jobs.sh "${MEM_PER_JOB_GB}" "${MEM_RESERVE_GB}" "${MAX_JOBS_CEILING}")"; \
    export MAX_JOBS="${njobs}"; \
    export VLLM_TARGET_DEVICE=cpu; \
    export CMAKE_BUILD_TYPE=Release; \
    export SETUPTOOLS_SCM_PRETEND_VERSION="${VLLM_REF#v}"; \
    export VLLM_DOCKER_BUILD_CONTEXT=1; \
    PYTHONDONTWRITEBYTECODE=1 python setup.py bdist_wheel --dist-dir=/raw-wheels \
    2>&1 | tee /wheels-build.log

SHELL ["/bin/sh", "-c"]

# All three ISA variants must be present. That this wheel serves on a
# runner without AVX-512 rests on _C_AVX2 alone: the other two die
# there with SIGILL at load, not with an ImportError.
#
# No GPU code: no offload bundle, and no extension linking a CUDA or
# HIP runtime. The NEEDED scan is the one the repair would hide — a
# libtorch_cuda dependency matches its `libtorch*` exclude.
#
# The repair is not optional: the extensions need libnuma.so.1 and
# python:slim has none, so the copy auditwheel grafts into vllm.libs is
# what lets them load. Checked by name because the repair is piped.
RUN --mount=type=tmpfs,target=/tmp/w \
    set -eu; \
    test "$(find /raw-wheels -maxdepth 1 -name '*.whl' | wc -l)" -eq 1; \
    raw=$(basename /raw-wheels/*.whl); \
    case "${raw}" in \
        "vllm-${VLLM_REF#v}+cpu-"*) ;; \
        *) echo "wheel is ${raw}, expected vllm-${VLLM_REF#v}+cpu-*" >&2; \
           exit 1 ;; \
    esac; \
    python -m zipfile -e /raw-wheels/*.whl /tmp/w; \
    for m in _C _C_AVX512 _C_AVX2 spinloop fs_io_C; do \
        test -f "/tmp/w/vllm/${m}.abi3.so" \
            || { echo "wheel has no vllm/${m}.abi3.so" >&2; exit 1; }; \
    done; \
    if grep -rl -e '__CLANG_OFFLOAD_BUNDLE' /tmp/w | grep -q . ; then \
        echo "GPU offload bundles found in a CPU wheel" >&2; exit 1; fi; \
    find /tmp/w -name '*.so*' -type f > /tmp/elfs.txt; \
    while read -r so; do \
        if readelf -d "${so}" | grep NEEDED \
            | grep -iE 'cuda|cudart|nvidia|amdhip|hiprt|rocm|sycl'; then \
            echo "${so} links a GPU runtime" >&2; exit 1; fi; \
    done < /tmp/elfs.txt; \
    rm /tmp/elfs.txt; \
    auditwheel repair /raw-wheels/*.whl -w /wheels \
        --exclude 'libtorch*.so*' --exclude 'libc10*.so*' \
        2>&1 | tee /wheels-tag.txt; \
    test "$(find /wheels -maxdepth 1 -name '*.whl' | wc -l)" -eq 1; \
    case "$(basename /wheels/*.whl)" in \
        *manylinux*) echo "repaired to $(basename /wheels/*.whl)" ;; \
        *) echo "auditwheel left ${raw} unrepaired" >&2; exit 1 ;; \
    esac; \
    echo cpu > /wheels-arch.txt

# wheels-arch.txt and the absent wheel-verdict call: see the same note
# in Dockerfile.lmcache-cpu.

# ─── Serving image ───────────────────────────────────────────────
# python:slim, not the builder — and not manylinux at all: llguidance
# ships no wheel for glibc 2.28, so the runtime dependencies resolve
# binary-only here and not there.
FROM python:${PYTHON_VERSION}-slim AS final

ARG VLLM_REF
ARG PYTORCH_VERSION

LABEL org.opencontainers.image.source="https://github.com/vllm-project/vllm"
LABEL org.opencontainers.image.description="vLLM ${VLLM_REF} serving image, CPU-only"

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONUNBUFFERED=1

# A compiler in a runtime image, because vLLM's CPU path compiles at
# serve time and does not serve without one. Measured on this image
# with none: the default mode dies in warmup (inductor, "No working C++
# compiler found"), and --enforce-eager only moves the failure to the
# first request, where the V2 model runner JITs a triton-cpu kernel
# ("Failed to find C compiler"). Upstream's CPU image carries gcc and
# g++ too. g++, not gcc alone: inductor asks for it by name and triton
# links its launcher against libstdc++.
RUN apt-get update && apt-get install -y --no-install-recommends g++ && \
    rm -rf /var/lib/apt/lists/*

# The torch family first, from the CPU index ALONE, so none of it can
# come from PyPI. The wheel names torchvision, torchaudio and
# torchcodec unpinned, and their own metadata pairs them with torch
# only loosely.
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==${PYTORCH_VERSION}+cpu" torchvision torchaudio "torchcodec>=0.14"

# Then pinned, so the resolves below can only keep them. Same
# construction as Dockerfile.lmcache.
RUN pip list --format=freeze > /tmp/pip-freeze.txt && \
    grep -E '^(torch|torchvision|torchaudio|torchcodec)==' /tmp/pip-freeze.txt \
        > /etc/pip-constraints.txt && \
    rm /tmp/pip-freeze.txt && \
    cat /etc/pip-constraints.txt
ENV PIP_CONSTRAINT=/etc/pip-constraints.txt

COPY --from=builder /wheels-build.log /wheels-tag.txt /wheels-arch.txt \
    /var/log/vllm-cpu-build/

# ─── vLLM and the LMCache client ─────────────────────────────────
# vLLM WITH dependencies: its metadata names nothing unresolvable, so
# installing through it is the test that the published wheel resolves.
# The CPU index is an extra because vLLM's metadata pins
# torch==<version>+cpu, which PyPI does not carry. LMCache is not
# optional — vLLM's MP connector imports it at module scope.
#
# LMCache --no-deps, which Dockerfile.vllm has always done and this
# lane now has to. The two wheels stopped being co-resolvable at vLLM
# v0.34.0:
#
#     vllm 0.34.0+cpu         depends on opentelemetry-api>=1.45.1
#     lmcache 0.5.7.post1+cpu depends on opentelemetry-api<=1.40.0,>=1.20.0
#     ERROR: ResolutionImpossible
#
# v0.33.0 floored it at 1.27.0, which left a window under LMCache's cap;
# v0.34.0 raised the floor past it. LMCache's cap is its own — the
# grpcio-observability pin that reads like its cause asks only for
# >=1.21.0 — and their dev branch still carries it, so there is no
# LMCache to bump to.
#
# Breaking LMCache's ceiling rather than vLLM's floor, because of what
# each side does with opentelemetry here. LMCache's is its
# mp_observability subsystem, which runs in the LMCache SERVER — a
# separate image and a separate process. What this image holds is the
# client shim behind LMCacheMPConnector, and the one otel import on that
# path, in lmcache/logging.py, is already inside a try/except ImportError
# that upstream documents as "no-op if opentelemetry is not installed".
# vLLM's floor, by contrast, is load-bearing for the server that runs
# here. Same reasoning as Dockerfile.vllm, reached from the other side.
#
# The requirements file is LMCache's own, patched at wheel-build time and
# shipped beside the wheel; the sed lifts the ceilings and fails loudly
# if there are none left to lift, so an LMCache that fixes this upstream
# becomes an error here rather than a silent edit.
#
# CEILINGS, plural, and that is the whole trick. LMCache caps two:
#
#     opentelemetry-api                 >= 1.20.0, <= 1.40.0
#     opentelemetry-exporter-prometheus >= 0.50b0, <= 0.61b0
#
# The second is the binding one. OpenTelemetry's exporters version as
# 0.xxbN against the 1.xx core — 0.61b0 belongs to 1.40.0 — so capping
# the exporter caps opentelemetry-sdk no matter what the api line says.
# Lifting only the api line leaves the resolve legal and silently
# DOWNGRADES the whole stack to 1.40 under a vLLM that asked for 1.45.1,
# which `pip check` then reports against vllm rather than lmcache. Every
# upper bound on an `opentelemetry-*` line goes, which also covers a
# third if LMCache adds one.
#
# triton joins the constraints afterwards: it arrived by direct URL as
# the +cpu build, and xgrammar's bare `triton` must not be answered
# with PyPI's by a later install.
COPY --from=lmcachewheels /requirements/common.txt \
    /opt/lmcache-requirements/common.txt

RUN set -eu; \
    f=/opt/lmcache-requirements/common.txt; \
    grep -qE '^opentelemetry-[a-z-]+ *>=.*<=' "$f" || { \
        echo "no capped opentelemetry pin left in LMCache's requirements;" >&2; \
        echo "upstream may have fixed this — drop the lift below:" >&2; \
        grep -n opentelemetry "$f" >&2; exit 1; }; \
    sed -i -E 's/^(opentelemetry-[a-z-]+ *>= *[0-9a-z.]+) *, *<= *[0-9a-z.]+$/\1/' "$f"; \
    ! grep -qE '^opentelemetry-[a-z-]+ *>=.*<=' "$f" || { \
        echo "an opentelemetry cap survived the lift:" >&2; \
        grep -n opentelemetry "$f" >&2; exit 1; }; \
    grep -n opentelemetry "$f"

RUN --mount=type=bind,from=builder,source=/wheels,target=/w/vllm \
    --mount=type=bind,from=lmcachewheels,source=/wheels,target=/w/lmcache \
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        /w/vllm/*.whl && \
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r /opt/lmcache-requirements/common.txt && \
    pip install --no-cache-dir --no-deps /w/lmcache/*.whl && \
    pip list --format=freeze > /tmp/pip-freeze.txt && \
    grep -E '^triton==.*\+cpu$' /tmp/pip-freeze.txt >> /etc/pip-constraints.txt && \
    rm /tmp/pip-freeze.txt && \
    cat /etc/pip-constraints.txt

# `pip check` still runs, and still fails the build on anything real.
# The tolerated lines are the ceilings deliberately broken above: the
# INSTALLED wheel's metadata still carries both, because only the
# requirements file was patched and the wheel is the published artifact.
#
# Matched on lmcache AND an opentelemetry name together, so a complaint
# about any other distribution — notably vllm, which is what a
# downgraded otel stack reads as — is still a failure, and so is a
# missing LMCache dependency.
RUN set -eu; \
    if pip check > /tmp/pip-check.txt 2>&1; then \
        cat /tmp/pip-check.txt; \
    else \
        cat /tmp/pip-check.txt; \
        if grep -v -E '^lmcache [^ ]+ has requirement opentelemetry-' \
            /tmp/pip-check.txt | grep -qE '[^[:space:]]'; then \
            echo "pip check reported more than the broken otel ceilings" >&2; \
            exit 1; \
        fi; \
        echo "pip check: only the deliberately broken otel ceilings"; \
    fi; \
    rm /tmp/pip-check.txt

# CpuPlatform is selected by the `+cpu` in the version. The variable
# makes that hold if the suffix is ever renamed: every other platform
# imports vllm._C unconditionally, which a host without AVX-512 cannot
# load.
ENV VLLM_TARGET_DEVICE=cpu \
    CUDA_VISIBLE_DEVICES=""

# What the image claims. No GPU distribution — by name, since the
# triton-cpu wheel does carry ptxas and libnvperf as plain files. The
# platform is the CPU one — asked with the variable unset, since set it
# is authoritative and the suffix, which is all an installed wheel has,
# would go untested — and the extension this host's CPUID selects
# registers its ops; import_kernels() only warns when the load fails,
# so the op lookup is the assertion. Both connectors import: vLLM's,
# and LMCache's own, which `LMCacheMPConnector` resolves to.
#
# Then _C_AVX2 by name, in its own process: the variant a runner
# without AVX-512 gets, and one a build host with AVX-512 would
# otherwise never load.
RUN pip list --format=freeze > /tmp/pip-freeze.txt && \
    if grep -iE '^(nvidia|cupy|nixl)|cuda' /tmp/pip-freeze.txt; then \
        echo "GPU distribution in a CPU image" >&2; exit 1; fi && \
    rm /tmp/pip-freeze.txt && \
    env -u VLLM_TARGET_DEVICE python -c "\
import torch, vllm, importlib.metadata as md;\
assert not torch.cuda.is_available() and not torch.version.cuda and not torch.version.hip;\
assert md.version('vllm').endswith('+cpu'), md.version('vllm');\
from vllm.platforms import current_platform as p;\
assert p.is_cpu(), type(p).__name__;\
p.import_kernels();\
torch.ops._C.silu_and_mul;\
from vllm.distributed.kv_transfer.kv_connector.v1 import lmcache_mp_connector;\
from lmcache.integration.vllm.lmcache_mp_connector import LMCacheMPConnector;\
print('vLLM', md.version('vllm'), '—', type(p).__name__, '— torch', torch.__version__)" && \
    python -c "\
import os, torch, vllm;\
torch.ops.load_library(os.path.join(os.path.dirname(vllm.__file__), '_C_AVX2.abi3.so'));\
x = torch.randn(4, 64); out = torch.empty(4, 32);\
torch.ops._C.silu_and_mul(out, x);\
err = float((out - torch.nn.functional.silu(x[:, :32]) * x[:, 32:]).abs().max());\
assert err < 1e-5, err;\
print('_C_AVX2 loads and computes — max abs err', err)"

EXPOSE 8000
ENTRYPOINT ["vllm"]
CMD ["serve", "--help"]

# ─── Wheel-only image ────────────────────────────────────────────
FROM scratch AS wheel

ARG VLLM_REF
LABEL org.opencontainers.image.source="https://github.com/vllm-project/vllm"
LABEL org.opencontainers.image.description="vLLM ${VLLM_REF} CPU-only (+cpu) wheel"

COPY --from=builder /wheels/ /wheels/
COPY --from=builder /wheels-build.log /wheels-tag.txt /wheels-arch.txt /
