# syntax=docker/dockerfile:1
# vLLM (github.com/vllm-project/vllm) built against this repo's ROCm
# 10.1 PyTorch, Triton and AITER, with NIXL for KV-cache transfer.
#
# Why build it: AMD publishes rocm/vllm-dev images, but they are built
# against AMD's own torch for ROCm 7.x. Ours is torch 2.15.0 on ROCm
# 10.1 for gfx950, and vLLM's HIP extensions link against torch's C++
# ABI — a prebuilt vLLM wheel and our torch cannot share a process.
#
# Why it builds FROM the PyTorch image rather than the ROCm base: the
# same reason as Dockerfile.aiter. setup.py imports torch to pick up the
# HIP toolchain and the ABI flags, so torch has to be present before the
# build starts, not installed alongside it.
#
# This file produces two things from one builder: a runnable serving
# image (`final`) and a scratch image carrying just the wheel (`wheel`),
# matching the split in Dockerfile.pytorch.

ARG PYTORCH_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/pytorch:latest
ARG TRITON_WHEEL_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/triton-wheel:latest
ARG AITER_WHEEL_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/aiter-wheel:latest
ARG NIXL_WHEEL_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/nixl-wheel:latest
# torchvision is a dependency of this image whether or not anything
# here asks for it: requirements/build/rocm.txt's replacement below
# installs timm, timm requires torchvision, and transformers'
# image_utils does `from torchvision.io import ...` at module scope.
# PyPI only publishes CUDA builds, so left to pip this image gets a
# torchvision whose _C_stable.so links libtorch_cuda and cannot load.
# Dockerfile.torchvision builds the ROCm one; this is where it lands.
ARG TORCHVISION_WHEEL_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/torchvision-wheel:latest
# LMCache is a dependency of vLLM, not an optional companion. vLLM ships
# its own connector, vllm/distributed/kv_transfer/kv_connector/v1/
# lmcache_mp_connector.py, and that module imports lmcache.utils and
# lmcache.integration.vllm.utils at top level — so `--kv-transfer-config
# '{"kv_connector":"LMCacheMPConnector"}'` fails at import without the
# package present. The cache engine still runs in its own container;
# only this client-side shim lives here.
ARG LMCACHE_WHEEL_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/lmcache-wheel:latest

FROM ${TRITON_WHEEL_IMAGE} AS tritonwheels
FROM ${AITER_WHEEL_IMAGE} AS aiterwheels
FROM ${NIXL_WHEEL_IMAGE} AS nixlwheels
FROM ${TORCHVISION_WHEEL_IMAGE} AS torchvisionwheels
FROM ${LMCACHE_WHEEL_IMAGE} AS lmcachewheels

# ─── Build environment: torch + the accelerator wheels ───────────
# Shared by the compile and by the final image, so both resolve the same
# versions of triton, aiter and nixl. Splitting it out also means a
# change to the vLLM ref does not reinstall them.
FROM ${PYTORCH_IMAGE} AS deps

ARG PYTORCH_ROCM_ARCH=gfx950
ARG ROCM_VERSION=10.1.0-full

# GPU_ARCHS is not a duplicate of PYTORCH_ROCM_ARCH. `import aiter`
# resolves the target architecture eagerly, and with GPU_ARCHS unset it
# falls back to "native" and shells out to rocminfo — which finds no
# device in a BuildKit RUN and raises "No gfx arch found in rocminfo
# output". Setting it also pins the arch at runtime rather than letting
# it be rediscovered from whichever GPU the container lands on.
ENV ROCM_PATH=/opt/rocm \
    PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH} \
    GPU_ARCHS=${PYTORCH_ROCM_ARCH} \
    VLLM_TARGET_DEVICE=rocm

# Bind mounts, not COPYs. These three used to land under /opt/wheels/
# and stay there for the life of the image — and `deps` is the base of
# both the serving image and the builder, so every one of them carried
# a gigabyte of wheels that had already been installed. Mounted, they
# exist for this RUN only.
#
# The wheels remain recoverable from triton-wheel, aiter-wheel,
# nixl-wheel and torchvision-wheel, which is what those targets are for.
#
# Order matters only in that triton must not be resolved from PyPI:
# upstream triton has no ROCm 10.1 build and installing it would shadow
# ours. --no-deps on the triton wheels keeps pip from "helpfully"
# pulling a published triton as a transitive dependency.
#
# torchvision is --no-deps as insurance, not because a plain install is
# known to break. Measured on this image: `pip install --dry-run` of the
# wheel resolves cleanly — "Requirement already satisfied: torch>=2.14.0
# ... (2.15.0a0+git31a77fc)" — so pip does count our source build's
# pre-release version as satisfying torchvision's `torch >= 2.14`, and
# would install nothing but torchvision itself.
#
# The guard is here anyway because of *where* this sits. If that
# resolution ever did reach PyPI for a final torch, it would replace the
# ROCm one with a CUDA build, and nothing would catch it:
# /etc/pip-constraints.txt is what makes that failure loud for every
# later install in this file, and it is generated from `pip list`, so it
# cannot exist until torchvision is already in. This is the one
# torchvision install with no net under it.
#
# Its two real dependencies are installed by hand right after. Both are
# already in the PyTorch image (numpy 2.5.4, pillow 13.0.0 as measured),
# so this is a no-op today and exists so that --no-deps does not quietly
# become wrong if the base image stops carrying them.
RUN --mount=type=bind,from=tritonwheels,source=/wheels,target=/w/triton \
    --mount=type=bind,from=aiterwheels,source=/wheels,target=/w/aiter \
    --mount=type=bind,from=nixlwheels,source=/wheels,target=/w/nixl \
    --mount=type=bind,from=torchvisionwheels,source=/wheels,target=/w/torchvision \
    pip install --no-cache-dir --no-deps /w/triton/*.whl && \
    pip install --no-cache-dir /w/aiter/*.whl && \
    pip install --no-cache-dir /w/nixl/*.whl && \
    pip install --no-cache-dir --no-deps /w/torchvision/*.whl && \
    pip install --no-cache-dir numpy "pillow>=5.3.0,!=8.3.*"

# AITER's wheel metadata does not carry its runtime dependencies — its
# setup.py never folds requirements.txt into install_requires, so pip
# installs it "successfully" and `import aiter` then dies on a missing
# pyyaml. Fetch the list at the same ref the wheel was built from rather
# than hand-maintaining a copy that drifts from it.
#
# Three entries are dropped: pytest and matplotlib are test and plotting
# deps, and flydsl is a *build*-time dependency of AITER (it appears in
# its pyproject [build-system].requires) whose published wheels do not
# cover this interpreter. None of them are imported by the kernels vLLM
# calls.
ARG AITER_REF=v0.1.27
ARG AITER_DROP_REQS='^(pytest|matplotlib|flydsl)([<=>;[:space:]]|$)'

RUN curl -fsSL \
        "https://raw.githubusercontent.com/ROCm/aiter/${AITER_REF}/requirements.txt" \
        -o /tmp/aiter-requirements.txt && \
    sed -i -E "/${AITER_DROP_REQS}/d" /tmp/aiter-requirements.txt && \
    cat /tmp/aiter-requirements.txt && \
    pip install --no-cache-dir -r /tmp/aiter-requirements.txt

RUN python -c "import triton; print('triton', triton.__version__)" && \
    python -c "import aiter; print('aiter ok')" && \
    python -c "from nixl._api import nixl_agent; print('nixl ok')" && \
    python -c "import torchvision; print('torchvision', torchvision.__version__)" && \
    python -c "\
from torchvision.io import ImageReadMode, decode_image;\
import torchvision.io.image as _tvi;\
assert _tvi._has_image_ops(), 'torchvision image extension did not load';\
print('torchvision.io ok — what transformers imports')"

# A pip constraint pinning torch, torchvision and triton to exactly what
# is installed. Several entries in vLLM's requirement files, and in the
# transitive closure below them, name one of the three — and the
# versions they name exist on PyPI as CUDA builds. Without this, one
# `pip install` deep in the dependency graph silently replaces the ROCm
# torch this whole pipeline exists to produce, and the failure surfaces
# much later as a missing HIP runtime. With it, that resolution fails
# loudly instead.
#
# torchvision is the one with a named culprit: requirements/build/rocm.txt's
# replacement below installs `timm>=1.0.17`, which depends on
# torchvision unconditionally. Our wheel versions itself
# `0.29.2+rocm10.1.0`, a local segment PyPI cannot offer, so the pin is
# unsatisfiable from anywhere but this image — which is the point.
# Written with pip rather than a python heredoc: hadolint cannot parse
# `RUN cmd <<'EOF'` and fails the lint job on a parse error, which no
# --ignore can suppress. `pip list --format=freeze` always emits
# name==version (plain `pip freeze` can emit a direct URL reference for
# a locally-installed wheel, which is not a usable constraint). No pipe,
# so a pip failure cannot be masked by a succeeding grep.
RUN pip list --format=freeze > /tmp/pip-freeze.txt && \
    grep -E '^(torch|torchvision|triton)==' /tmp/pip-freeze.txt > /etc/pip-constraints.txt && \
    rm /tmp/pip-freeze.txt && \
    cat /etc/pip-constraints.txt
ENV PIP_CONSTRAINT=/etc/pip-constraints.txt

# vLLM's ROCm platform layer imports amdsmi to enumerate devices. It is
# not on PyPI for ROCm 10.1; it ships inside the ROCm installation.
#
# `pip install /opt/rocm/share/amd_smi` is what older ROCm images
# supported and what most guides still say, but ROCm 10.1 ships that
# directory with no setup.py and no pyproject.toml — pip rejects it as
# "not installable". The package itself is complete and binds to
# libamd_smi.so through ctypes, so putting it on sys.path is enough. A
# .pth file does that without copying the tree or shadowing the ROCm
# installation's own copy.
RUN set -eu; \
    test -d /opt/rocm/share/amd_smi/amdsmi; \
    sp=$(python -c "import sysconfig; print(sysconfig.get_paths()['purelib'])"); \
    printf '/opt/rocm/share/amd_smi\n' > "${sp}/rocm-amdsmi.pth"; \
    python -c "import amdsmi; print('amdsmi ok:', amdsmi.__file__)"

# ─── Builder ─────────────────────────────────────────────────────
FROM deps AS builder

ARG VLLM_REF=v0.33.0
ARG SCCACHE_WEBDAV_ENDPOINT=http://snoc-strix.fold-leaffish.ts.net:8081
# Key namespace within the shared store, and a unix socket rather than a
# TCP port — the builders run with --driver-opt network=host, so a fixed
# SCCACHE_SERVER_PORT is shared by every container on the node and two
# builds' sccache servers cross. See the long note in Dockerfile.aiter.
ARG SCCACHE_WEBDAV_KEY_PREFIX=rocm-pytorch
# Empty means "derive from the node"; set it to pin a job count.
ARG MAX_JOBS=
# Memory budget per compile job, used to derive MAX_JOBS. The shared
# convention with Dockerfile.pytorch is 2GB, measured for cc1plus; this
# build uses 1GB, and the difference is deliberate.
#
# Until v0.33 the number did not matter here. csrc/rocm/attention.cu was
# a single translation unit holding the whole critical path, so the
# build was one compile on one core no matter what was derived. v0.33
# splits it into twelve, and the ninja graph now wants about 16 slots
# for ~140s — a job count derived too low re-serializes into waves and
# gives back most of what the split returned.
#
# 1GB is what these compiles actually take: a 32-job gfx1201 run peaked
# at 24GB across ~46 processes, about 0.75GB each. One outlier did reach
# 7GB resident on its own, which is the reason this is 1 and not lower —
# the cap at nproc and the single-outlier headroom both still apply.
ARG MEM_PER_JOB_GB=1
# vLLM builds a Rust extension (vllm/vllm-rs) as part of setup.py.
# The channel tracks the repo's rust-toolchain.toml.
ARG RUST_VERSION=1.95

LABEL org.opencontainers.image.source="https://github.com/vllm-project/vllm"
LABEL org.opencontainers.image.description="vLLM ${VLLM_REF} for ROCm ${ROCM_VERSION}, ${PYTORCH_ROCM_ARCH}"

# SCCACHE_IDLE_TIMEOUT=0 — never, rather than sccache's default 600s.
#
# Under v0.32 this build was one long pole: 50 ninja edges, 48 of which
# finished in 139s, and then csrc/rocm/attention.hip.o alone ran for
# 1115s of a 1324s build. While that single compile held the critical
# path no new requests reached the local sccache server, it passed its
# idle timeout and exited, and the next client found it gone:
#
#   sccache: warning: The server looks like it shut down unexpectedly,
#   compiling locally instead
#
# Measured on the gfx1201 cold run 20261102T161307Z, where the final
# `--show-stats` then reported zeroes across the board — not because
# nothing was cached, but because it had spawned a fresh server to ask.
# Not memory: the node held 106GB+ free throughout.
#
# v0.33 splits that file and no TU now reaches the 600s default: the
# longest cold compile measured is csrc/rocm/skinny_gemms_int4.hip.o at
# 304s on gfx1201, and 151s on gfx950 where that file is behind
# __HIP__GFX1X__ and compiles to a stub. So this no longer fixes a
# reproduced failure — it keeps one TU's growth from quietly
# reintroducing it, which is how the gfx1201 case arrived in the first
# place (that file was 119.6s under v0.32).
#
# Only this build has ever been long-poled enough to hit it. PyTorch's
# 2772 objects keep their server busy continuously, which is why the
# same default has never caused trouble there.
#
# RUSTC_WRAPPER is a separate lever from the CMAKE_*_COMPILER_LAUNCHER
# above: setup.py builds vllm/vllm-rs, and sccache saw zero rustc calls
# without it — its stats carried no Rust lines at all.
# Worth about 50s of a rebuild (the cargo release profile reported
# 51.64s on run 20261102T183000Z, against 26s for the whole HIP phase
# once that was cached), so a tenth of what the idle-timeout fix
# returned, not a second one of it.
#
# CARGO_INCREMENTAL=0 because sccache declines to cache incremental
# compilation. The release profile already disables it, so this states
# the requirement rather than changing behaviour — and keeps a profile
# change upstream from silently turning the caching back off.
#
# CC/CXX are deliberately NOT wrapped. Crates with a build.rs compile
# their C through cc-rs, which reads CC, so those stay uncached — but
# CMake reads CC too, and setting it to "sccache cc" here would stack a
# launcher on top of the CMAKE_*_COMPILER_LAUNCHER already set above.
# The HIP path is the expensive one and it is covered; this is not
# worth risking it for.

# sccache on S3, for builds that are not on the fleet. Empty selects
# the WebDAV store above: sccache treats an empty SCCACHE_BUCKET as
# unset, so these are inert on SNOC. Credentials are NOT args — they
# arrive as a BuildKit secret, so they stay out of image history.
ARG SCCACHE_BUCKET=
ARG SCCACHE_REGION=
ARG SCCACHE_S3_KEY_PREFIX=rocm-pytorch

ENV SCCACHE_WEBDAV_ENDPOINT=${SCCACHE_WEBDAV_ENDPOINT} \
    SCCACHE_BUCKET=${SCCACHE_BUCKET} \
    SCCACHE_REGION=${SCCACHE_REGION} \
    SCCACHE_S3_KEY_PREFIX=${SCCACHE_S3_KEY_PREFIX} \
    SCCACHE_SERVER_UDS=/tmp/sccache.sock \
    SCCACHE_WEBDAV_KEY_PREFIX=${SCCACHE_WEBDAV_KEY_PREFIX} \
    SCCACHE_IGNORE_CLIENT_VERSION=1 \
    SCCACHE_IDLE_TIMEOUT=0 \
    SCCACHE_CONF=/etc/sccache.toml \
    CMAKE_C_COMPILER_LAUNCHER=sccache \
    CMAKE_CXX_COMPILER_LAUNCHER=sccache \
    CMAKE_HIP_COMPILER_LAUNCHER=sccache \
    RUSTC_WRAPPER=/usr/local/bin/sccache \
    CARGO_INCREMENTAL=0 \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:${PATH}

ARG SCCACHE_VERSION=0.19.0
RUN curl -fsSL "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    -o /tmp/sccache.tar.gz && \
    tar xzf /tmp/sccache.tar.gz -C /usr/local/bin --strip-components=1 \
        "sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache" && \
    rm /tmp/sccache.tar.gz && chmod +x /usr/local/bin/sccache && sccache --version

# The 10s server-startup probe compiled into sccache is not enough when
# the node hosting the WebDAV store is itself building; see the same
# note in Dockerfile.triton.
RUN printf 'server_startup_timeout_ms = 60000\n' > /etc/sccache.toml

RUN apt-get update && apt-get install -y --no-install-recommends \
    libnuma-dev \
    libdnnl-dev \
    libmsgpack-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh && \
    sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal \
        --default-toolchain ${RUST_VERSION} && \
    rm /tmp/rustup-init.sh && cargo --version

RUN git clone --depth 1 --branch ${VLLM_REF} \
    https://github.com/vllm-project/vllm.git /opt/vllm

WORKDIR /opt/vllm

# requirements/rocm.txt mixes three things: runtime deps, test deps, and
# optional feature deps. Several of the optional ones have no wheel for
# cp314 or no ROCm 10.1 build at all, and a single unresolvable pin
# fails the whole install — so they are stripped rather than allowed to
# decide whether this image exists.
#
# What goes and why:
#   tensorizer, runai-model-streamer  alternate model loaders, x86 wheels only
#   amd-quark                         Quark quantization, ROCm 7.x builds
#   tilelang, apache-tvm-ffi          optional kernel DSL, no cp314 wheel
#   mooncake-transfer-engine-rocm     a second KV transport; we use NIXL
#   datasets, peft, pytest-asyncio    test-suite deps, not serving deps
#
# Override VLLM_DROP_REQS to keep any of them once a usable wheel exists.
ARG VLLM_DROP_REQS='^(tensorizer|runai-model-streamer|amd-quark|tilelang|apache-tvm-ffi|mooncake-transfer-engine-rocm|datasets|peft|pytest-asyncio)([<=>\[[:space:]]|$)'

RUN cp requirements/rocm.txt /tmp/rocm.txt.orig && \
    sed -i -E "/${VLLM_DROP_REQS}/d" requirements/rocm.txt && \
    echo "--- dropped from requirements/rocm.txt ---" && \
    diff /tmp/rocm.txt.orig requirements/rocm.txt || true

# requirements/build/rocm.txt is deliberately NOT used: it pins torch,
# torchvision and triton from AMD's repo.amd.com index (ROCm 7.14), which
# would replace every wheel this image is built around. This is that file
# with the toolchain entries kept and the framework pins dropped. cmake is
# capped below 4 for the same reason upstream caps it — vLLM's ROCm CMake
# path does not survive the 4.x policy changes.
#
# timm is the entry that reaches torchvision. It is satisfied here, not
# resolved: `deps` already installed the torchvision-wheel build, and
# PIP_CONSTRAINT pins it, so timm finds its dependency present rather
# than fetching PyPI's CUDA build over it.
RUN pip install --no-cache-dir \
        "cmake>=3.26.1,<4" ninja "packaging>=24.2" \
        "setuptools>=78.1.1,<80.0.0" "setuptools-scm>=8" \
        "setuptools-rust>=1.9.0" wheel "jinja2>=3.1.6" "timm>=1.0.17"

RUN pip install --no-cache-dir -r requirements/rocm.txt && \
    python -c "import torch; print('torch still', torch.__version__, torch.version.hip)"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# setup.py directly, not `python -m build`: vLLM pins torch == 2.13.0 in
# [build-system].requires, which a PEP 517 front end verifies and ours
# does not satisfy. Nothing in the HIP build depends on that exact
# minor — the pin exists to stop PyPI resolving a mismatched torch for
# people who are not supplying their own. Upstream's own ROCm
# Dockerfile calls setup.py for the same reason.
#
# The clone is shallow and tag-pinned, so setuptools_scm can see the tag
# but not the depth of history it wants; pretending the version keeps
# the wheel name from becoming 0.1.dev1+unknown.
#
# njobs, not MAX_JOBS, for the computation: MAX_JOBS is a build ARG, so
# BuildKit substitutes every ${MAX_JOBS} in this instruction with the
# ARG's value before the shell runs — assigning to it in the shell does
# not change what the later expansions were replaced with. Compute into
# a name BuildKit does not know about, then export it once.
# sccache reads its credentials from the environment. On the fleet
# there is no secret and the WebDAV store needs none; on S3 this is
# the only way they reach the RUN sandbox, which has no ~/.aws and
# cannot route to the container credential endpoint. The secret is a
# tmpfs file for the life of this instruction, so it never lands in
# image history or a published layer.
RUN --mount=type=secret,id=aws,required=false \
    if [ -s /run/secrets/aws ]; then set -a; . /run/secrets/aws; set +a; fi; \
    njobs="${MAX_JOBS}"; \
    if [ -z "${njobs}" ]; then \
        cores=$(nproc); \
        njobs=$(awk -v per="${MEM_PER_JOB_GB}" '/^MemAvailable:/ {print int($2/1024/1024/per)}' /proc/meminfo); \
        [ -n "${njobs}" ] || njobs=${cores}; \
        [ "${njobs}" -ge 1 ] || njobs=1; \
        [ "${njobs}" -le "${cores}" ] || njobs=${cores}; \
        echo "MAX_JOBS=${njobs} (from ${cores} cores, $(awk '/^MemAvailable:/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) available)"; \
    else \
        echo "MAX_JOBS=${njobs} (pinned via build arg)"; \
    fi; \
    export MAX_JOBS="${njobs}"; \
    export SETUPTOOLS_SCM_PRETEND_VERSION="${VLLM_REF#v}"; \
    export VLLM_DOCKER_BUILD_CONTEXT=1; \
    PYTHONDONTWRITEBYTECODE=1 python setup.py bdist_wheel --dist-dir=/wheels \
    2>&1 | tee /wheels-build.log \
    && sccache --show-stats | tee /wheels-sccache-stats.txt

SHELL ["/bin/sh", "-c"]

# The ROCm extension must actually carry code objects for the arch this
# was built for. A mismatched PYTORCH_ROCM_ARCH produces a wheel that
# imports cleanly and then fails at the first kernel launch on a real
# GPU, which is a long way from here.
RUN --mount=type=tmpfs,target=/tmp/vllm-wheel \
    set -eu; \
    python -m zipfile -e /wheels/*.whl /tmp/vllm-wheel; \
    so=$(find /tmp/vllm-wheel -type f -name '_C*.so' | head -1); \
    test -n "${so}"; \
    echo "checking offload bundles in ${so}"; \
    /opt/rocm/llvm/bin/llvm-objdump --offloading "${so}" \
        | grep -oE 'gfx[0-9a-z]+' | sort -u | tee /wheels-arch.txt; \
    for arch in $(echo "${PYTORCH_ROCM_ARCH}" | tr ';' ' '); do \
        grep -qx "${arch}" /wheels-arch.txt || { \
            echo "wheel has no code objects for ${arch}" >&2; exit 1; }; \
    done

# No auditwheel step here, for the same reason as Dockerfile.pytorch
# and Dockerfile.triton: vllm/vllm-rs references GLIBC_2.43, newer than
# any manylinux policy auditwheel knows, so linux_x86_64 is the only
# tag the symbols allow. Unlike those two, that was never written down
# here -- the wheel just came out linux_x86_64 and nobody said why.
# This states the reason and checks it, so a base-image glibc change
# cannot leave vLLM shipping the narrowest possible tag by accident.
COPY docker/wheel-verdict.py /usr/local/bin/wheel-verdict
RUN pip install --no-cache-dir auditwheel && \
    wheel-verdict /wheels no-manylinux

RUN ls -la /wheels/

# ─── Serving image ───────────────────────────────────────────────
# FROM deps, not from builder: the builder carries a Rust toolchain, a
# vLLM source tree and a CMake build directory that together outweigh
# the wheel by an order of magnitude.
FROM deps AS final

ARG VLLM_REF=v0.33.0
ARG PYTORCH_ROCM_ARCH
ARG ROCM_VERSION

LABEL org.opencontainers.image.source="https://github.com/vllm-project/vllm"
LABEL org.opencontainers.image.description="vLLM ${VLLM_REF} serving image for ROCm ${ROCM_VERSION}, ${PYTORCH_ROCM_ARCH}"

COPY --from=builder /wheels-build.log /wheels-sccache-stats.txt /wheels-arch.txt \
    /var/log/vllm-build/
# The patched requirements, not the originals: installing the wheel's
# own metadata would re-resolve the dependencies this build deliberately
# dropped, and pull a CUDA torch in with them.
#
# Copied rather than mounted, unlike the wheel: this is a few KB and it
# is the record of what was actually dropped, which is worth being able
# to read out of a published image.
COPY --from=builder /opt/vllm/requirements/ /opt/vllm-requirements/

# The wheel is mounted, not copied — vllm-wheel publishes it, so a copy
# here only added its weight to every pull of the serving image.
RUN --mount=type=bind,from=builder,source=/wheels,target=/w/vllm \
    pip install --no-cache-dir -r /opt/vllm-requirements/rocm.txt && \
    pip install --no-cache-dir --no-deps /w/vllm/*.whl && \
    python -c "import vllm; print('vLLM', vllm.__version__)" && \
    python -c "import torch; assert torch.version.hip, 'torch lost its HIP build'"

# ─── LMCache client ──────────────────────────────────────────────
# Not an optional companion. vLLM ships the connector itself —
# vllm/distributed/kv_transfer/kv_connector/v1/lmcache_mp_connector.py
# — and that module imports lmcache.utils and
# lmcache.integration.vllm.utils at top level, so serving with
# --kv-offloading-backend lmcache fails at import without the package.
# Upstream's own example says as much: "Requires lmcache to be installed".
# The cache engine still runs in its own container; this is the client.
COPY --from=lmcachewheels /requirements/ /opt/lmcache-requirements/

# Pin grpcio to what vLLM already resolved, before LMCache's
# requirements are installed. The two dependency sets overlap, and left
# alone pip moves it:
#
#     vllm 0.32.0 requires grpcio==1.78.0, but you have grpcio 1.85.0
#
# LMCache asks for grpcio>=1.78.0, a floor rather than a conflict, so
# holding the installed version satisfies both and pip's upward
# resolution was gratuitous.
#
# opentelemetry is deliberately NOT pinned, and the first version of
# this pinned it and broke the build. vLLM resolves
# opentelemetry-api 1.45.1; LMCache requires ">=1.20.0, <=1.40.0".
# Pinning vLLM's version contradicts LMCache's cap and turns a
# resolvable conflict into an unresolvable one:
#
#     ERROR: Cannot install opentelemetry-api<=1.40.0 and >=1.20.0
#            because these package versions have conflicting dependencies
#     ERROR: ResolutionImpossible
#
# Pinning only fixes a floor-vs-exact mismatch. A real version
# disagreement it cannot, so LMCache's cap wins and opentelemetry is
# downgraded. That costs vLLM's OTLP exporter, which wants
# sdk~=1.45.1 — but vLLM tracing is opt-in (--otlp-traces-endpoint) and
# unused here, while LMCache loads its observability on every start.
# This breaks the path nobody exercises rather than the one that always
# runs.
RUN python -c "\
import importlib.metadata as md;\
print(f'grpcio=={md.version(\"grpcio\")}')" \
    >> /etc/pip-constraints.txt && \
    sort -u /etc/pip-constraints.txt -o /etc/pip-constraints.txt && \
    cat /etc/pip-constraints.txt

# --no-deps on the wheel with the patched requirements installed first,
# so pip cannot re-resolve install_requires and reintroduce the
# CUDA-only entries that build stripped.
RUN --mount=type=bind,from=lmcachewheels,source=/wheels,target=/w/lmcache \
    pip install --no-cache-dir -r /opt/lmcache-requirements/common.txt && \
    pip install --no-cache-dir --no-deps \
        /w/lmcache/*.whl && \
    python -c "import lmcache; print('LMCache', lmcache.__version__)" && \
    python -c "import torch; assert torch.version.hip, 'torch lost its HIP build'"

# The connector module itself, not just the two lmcache modules it
# imports. This is the assertion that matters — it is the exact import
# `--kv-transfer-config '{"kv_connector":"LMCacheMPConnector"}'`
# performs at startup, so a failure here is a failure to serve.
#
# It was weakened to the two leaf imports for a long time because this
# import pulls in transformers, transformers' image_utils does
#
#     from torchvision.io import ImageReadMode, decode_image
#
# at module scope, and the torchvision in this image was PyPI's CUDA
# build, which cannot load on ROCm. torchvision-wheel is what fixed
# that; this is the check that proves it, and it will fail loudly if
# the ROCm torchvision is ever lost to a PyPI resolution.
RUN python -c "\
from vllm.distributed.kv_transfer.kv_connector.v1 import lmcache_mp_connector;\
print('vllm LMCacheMPConnector imports OK')"

# ─── Wheel-only image ────────────────────────────────────────────
FROM scratch AS wheel

ARG VLLM_REF
ARG PYTORCH_ROCM_ARCH
LABEL org.opencontainers.image.source="https://github.com/vllm-project/vllm"
LABEL org.opencontainers.image.description="vLLM ${VLLM_REF} wheel for ${PYTORCH_ROCM_ARCH}"

COPY --from=builder /wheels/ /wheels/
COPY --from=builder /wheels-build.log /wheels-sccache-stats.txt /wheels-arch.txt /
