# syntax=docker/dockerfile:1
# A ROCm base carrying one GPU architecture instead of all of them.
#
# `rocm/dev-ubuntu-26.04:10.1.0-full` unpacks to 20.5 GB and compresses
# to a single 8.67 GB layer, which was 71-95% of every image this repo
# published. AMD publishes no `-runtime` or `-base` variant of this tag
# — only `-full` exists for ROCm 10.1 — so the trimming has to happen
# here. Dockerfile.runtime has carried a comment saying exactly this
# since it was written.
#
# Two stages, and the second one is the point. A `rm` in a child layer
# reclaims nothing: the parent layer is still in the chain and still
# pulled. Copying the pruned filesystem into a fresh stage is what
# actually flattens it — the result is one new layer sized at what
# survived, and the 8.67 GB original is not in this image's chain at
# all.
#
# Measured, gfx950: 20.53 GB installed -> 4.4 GB on disk.

ARG ROCM_VERSION=10.1.0-full
ARG SDK_IMAGE=rocm/dev-ubuntu-26.04:${ROCM_VERSION}

# ─── Prune ───────────────────────────────────────────────────────
FROM ${SDK_IMAGE} AS pruned

ARG PYTORCH_ROCM_ARCH=gfx950
# keep-toolchain | minimal. See docker/rocm-prune.sh for what each one
# takes, and docs/reference/image-sizes.md for what each one costs.
ARG ROCM_PRUNE_PROFILE=keep-toolchain

COPY docker/rocm-prune.sh /tmp/rocm-prune.sh
RUN /tmp/rocm-prune.sh "${PYTORCH_ROCM_ARCH}" "${ROCM_PRUNE_PROFILE}" \
    && rm /tmp/rocm-prune.sh

# ─── Flatten ─────────────────────────────────────────────────────
# The whole root, onto scratch.
#
# Copying /opt/rocm alone does not work, and the failure is quiet: a
# ROCm installation reaches outside that tree — ld.so.conf.d entries,
# /etc/alternatives, the sysdeps and udev packages — and an image
# missing them loads libamdhip64 and then finds no device. Taking the
# root keeps all of it without anyone having to enumerate it.
#
# scratch rather than a fresh `ubuntu:26.04`, because the pruned root
# already contains that Ubuntu: layering it over another copy would
# ship the same files twice. The cost is that nothing is inherited —
# PATH has to be written out in full below rather than extended.
FROM scratch AS rocm-runtime

ARG ROCM_VERSION
ARG PYTORCH_ROCM_ARCH
ARG ROCM_PRUNE_PROFILE

LABEL org.opencontainers.image.source="https://github.com/sbates130272/rocm-bake"
LABEL org.opencontainers.image.description="ROCm ${ROCM_VERSION} runtime for ${PYTORCH_ROCM_ARCH} (${ROCM_PRUNE_PROFILE})"

# DL3067, "do not copy an entire filesystem from another stage", is
# good advice and is precisely what this file exists to do: copying the
# whole root IS the flattening step, and copying less is the bug
# described above. The directive has to be the line immediately before
# the instruction, which is why this explanation comes first.
# hadolint ignore=DL3067
COPY --from=pruned / /

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH=/opt/rocm
# Spelled out, not extended: on scratch there is no inherited PATH, so
# ${PATH} would expand to nothing and leave an image where `ls` is not
# on the path.
ENV PATH=/opt/rocm/bin:/opt/rocm/llvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/opt/rocm/lib

# The checks that matter are the ones a `rm` can silently invalidate.
# Each of these was broken by a version of rocm-prune.sh during
# development, and each failed somewhere far from here when it was:
#
#  - the HIP runtime resolving through /opt/rocm/lib, which stops
#    working the moment the alternatives farm is purged out from under
#    the symlinks while every file is still present
#  - kernel libraries for the architecture this image is for, and for
#    no other — the whole point of the prune, and the one error that
#    surfaces only on a real GPU
RUN set -eu; \
    test -e /opt/rocm/lib/libamdhip64.so; \
    ldconfig; \
    for a in $(echo "${PYTORCH_ROCM_ARCH}" | tr ';' ' '); do \
        ls -d "/opt/rocm/lib/hipblaslt/library/${a}" > /dev/null \
            || { echo "no hipblaslt kernels for ${a}" >&2; exit 1; }; \
    done; \
    found=$(find /opt/rocm/lib/hipblaslt/library/ -mindepth 1 -maxdepth 1 \
            -printf '%f '); \
    echo "ROCm ${ROCM_VERSION} (${ROCM_PRUNE_PROFILE}) for: ${found}"

CMD ["/bin/bash"]
