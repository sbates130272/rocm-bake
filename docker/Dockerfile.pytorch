# syntax=docker/dockerfile:1
# PyTorch ROCm build from source, targeting gfx950 by default
# Builds PyTorch with HIP support; PYTORCH_ROCM_ARCH selects the target
# Requires PyTorch 2.15.0+ and ROCm 10.1+

# Both ARGs before the first FROM: an ARG declared after a FROM belongs
# to that stage, and a later `FROM ${X}` then sees it blank. This file,
# Dockerfile.base and Dockerfile.runtime have each been broken by that
# rule before.
ARG TRITON_WHEEL_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/triton-wheel:latest
ARG BASE_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/base:10.1.0-full-3.14
ARG TORCH_WHEEL_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/pytorch-wheel:latest
# Up here with the others, and not beside its own FROM, for the
# reason the comment above states: an ARG used in a FROM has to be
# declared before the FIRST FROM, or it is scoped to whichever
# stage precedes it and expands to nothing. Declared next to its
# own stage it produced `base name (${PYTORCH_SRC_IMAGE}) should
# not be blank`, which is the third file in this repo to learn it.
ARG PYTORCH_SRC_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/pytorch-src:latest

# Our ROCm 10.1 triton, installed into the shipped image below.
FROM ${TRITON_WHEEL_IMAGE} AS tritonwheels

# The torch wheel this file's own `wheel` stage produced, on a previous
# target. `final` takes it from here rather than from `builder`, so the
# builder stage is unreachable from `final` and buildkit does not build
# it — which is what stops the compile step running twice. The bake
# `pytorch` target supplies this as a context on `pytorch-wheel`.
FROM ${TORCH_WHEEL_IMAGE} AS torchwheels

# Named context, supplied by bake's `pytorch-src` target or by its
# published ref under PUBLISHED_INPUTS. The default keeps a bare
# `docker build` on this file working.
FROM ${PYTORCH_SRC_IMAGE} AS pytorchsrc

FROM ${BASE_IMAGE} AS builder

# ─── PyTorch source checkout ─────────────────────────────────────
# These precede the LABELs below on purpose: an ARG referenced before it
# is declared expands to the empty string, and the label silently loses
# the version it is meant to record.
ARG PYTORCH_VERSION=2.15.0
ARG ROCM_VERSION=10.1.0-full
ARG USE_AITER=ON
ARG USE_FLYDSL=ON
ARG USE_FLASH_ATTENTION=ON
# RDNA4 Composable Kernel SDPA, new in 2.15 and OFF upstream. bake
# derives this from the target architecture; OFF here matches both.
ARG USE_ROCM_CK_SDPA_GFX12=OFF
ARG GIT_REF=""
# Declared or the ENV references below expand to empty and the build
# silently targets no GPU architecture at all.
ARG PYTORCH_ROCM_ARCH=gfx950
ARG PYTHON_VERSION=3.14

LABEL org.opencontainers.image.source="https://github.com/sbates130272/rocm-pytorch-build"
LABEL org.opencontainers.image.description="PyTorch ${PYTORCH_VERSION} ROCm ${ROCM_VERSION} ${PYTORCH_ROCM_ARCH} build"

# --recurse-submodules is not optional: PyTorch builds from third_party
# submodules, and a plain clone produces empty directories and a cmake
# failure a long way into the build.
#
# --jobs, because git fetches submodules ONE AT A TIME: submodule.
# fetchJobs defaults to 1 when unset, and -j/--jobs is the only thing
# that changes it. PyTorch has 36 submodules at v2.15.0, so the clone
# is 37 sequential fetches.
#
# Measured, and it is a far smaller win than it looks like it should
# be:
#
#   serial (no --jobs)   206.0s, 209.3s   two cold runs
#   --jobs 8             179.5s           cold, same clone step
#
# ~27s, or 13%. Not the ~60-90s a naive 36-way-serial model predicts,
# which means submodule FETCHING was never the dominant term in this
# band. The floor is the checkout of ~80k files plus the superproject,
# and --jobs does not touch either. Raising it further is very unlikely
# to pay: there is only ~27s of parallelisable work in the whole step.
#
# Keep the flag anyway — 27s for one word, with no measured downside.
# But do not reach for this pattern elsewhere expecting more.
#
# COLD ONLY. On a normal run this layer is a cache hit — target-costs
# records pytorch-wheel moving 17KB on a warm build — so none of the
# above applies to the builds run most often.
#
# If the proxy ever throttles 8 concurrent TLS sessions to github.com,
# it surfaces as a clone failure mid-build rather than a slow build.
# No edit needed to back off: --set '*.args.GIT_JOBS=4' on the bake
# invocation.
#
# Not --revision here, unlike Dockerfile.triton. PYTORCH_VERSION names a
# tag, so --branch v<version> with --depth 1 already fetches only that
# tag's tip; --revision would be equivalent for the superproject and
# reaches nothing in the submodules, which are the cost. It would also
# leave a clone with no refs, and PyTorch's version machinery reads git
# metadata.
# The clone moved to Dockerfile.pytorch-src, and everything above is
# kept as the record of why its flags are what they are.
#
# It was here, on top of ${BASE_IMAGE}, so a change to ROCm or to the
# prune invalidated an 8-minute network fetch that had nothing to do
# with either. The comment above already said this layer is normally a
# cache hit — true, and it stopped being true three times on
# 2026-11-03 while the pruned base was being rebuilt.
#
# COPY rather than a bind mount, unlike the wheels: the build writes
# into this tree (setup.py, the HIPify pass, CMake's build directory),
# so it has to be a real copy in the builder. It costs a layer in a
# stage that is never published.
COPY --from=pytorchsrc /opt/pytorch /opt/pytorch

WORKDIR /opt/pytorch

# ─── sccache compiler cache ──────────────────────────────────────
# Install sccache binary (prebuilt from Mozilla releases).
#
# The floor is 0.8.0, not a preference. Before it, gcc.rs had no "hip"
# arm in its -x handling and fell through to cannot_cache!("-x"), so
# every hipcc device compile was refused: a gfx950 build cached its C++
# objects and recompiled every GPU kernel, which are the expensive ones.
# Measured on 0.7.7: 990 of 1003 non-cacheable calls were "-x".
ARG SCCACHE_VERSION=0.19.0
# Pinned by content, not just by version tag: a release asset can be
# replaced after publication, and this binary wraps every compile in
# the pipeline. ADD --checksum fails the build on mismatch, where curl
# would happily install whatever it was served.
ARG SCCACHE_SHA256=aa73c7270c997894038c0d8f0d297865f57569e1687883322bc431713d4bb9dd
ADD --checksum=sha256:${SCCACHE_SHA256} \
    "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    /tmp/sccache.tar.gz
RUN tar xzf /tmp/sccache.tar.gz -C /usr/local/bin --strip-components=1 \
        "sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache" && \
    rm /tmp/sccache.tar.gz && chmod +x /usr/local/bin/sccache && sccache --version

# sccache runs its own server inside this container, backed by the shared
# WebDAV store on Strix. Three things here are load-bearing:
#
#  - WebDAV, not SCCACHE_DIR. A local directory is discarded with the
#    layer, which is how this silently cached nothing before. The store
#    is shared, so an object compiled on one node is a hit on the others,
#    and it is a directory tree on disk, so it survives a reboot.
#  - A port no host process uses. The builder runs with network=host, so
#    a client on 4226 would attach to the node's own sccache.service —
#    and that server executes compiles in the *host* filesystem, where
#    this container's sources do not exist (it fails with exit 254).
#  - The tailnet name resolves only because the buildkitd.toml rendered
#    per node from .builders/buildkitd.toml.in sets [dns] for the build
#    sandbox, from the manifest's `domain:`. RUN steps do not inherit the
#    builder's resolver, so without that block this fails with "cache
#    storage failed to read ... I/O error" and the build silently falls
#    back to no caching at all.
ARG SCCACHE_WEBDAV_ENDPOINT=http://snoc-strix.fold-leaffish.ts.net:8081
# Namespace this project's objects. The store is shared with other
# projects on the same fleet, and while sccache's keys are content
# hashes (so sharing is normally safe and desirable), entries written
# while two containers' sccache servers were crossed over a host port
# were wrong — a triton build hit them and died with "stdlib.h: No such
# file or directory" on a system that compiles that header fine. Proven
# by rebuilding under an isolated prefix: zero such errors.
#
# The crossing itself is fixed by SCCACHE_SERVER_UDS above, so this
# prefix is about abandoning the already-poisoned entries without
# deleting a store other projects are still using, and about bounding
# the blast radius if it ever recurs.
ARG SCCACHE_WEBDAV_KEY_PREFIX=rocm-pytorch
# A unix socket, not a TCP port. The builders run with
# --driver-opt network=host, so SCCACHE_SERVER_PORT is shared by every
# container on the node. A concurrent vLLM build on snoc-strix held
# 4250, our triton client connected to *its* sccache server, and that
# server could not see /opt/triton in its own mount namespace:
#
#   sccache: error: failed to spawn Command { cd "/opt/triton/build/..."
#   sccache: caused by: No such file or directory (os error 2)
#
# Same root cause as the long-settled "one shared sccache server is
# impossible" finding: the server compiles from its own filesystem. A
# socket inside the container cannot be reached by another container,
# so each build necessarily gets its own server.
# true forces every compile to run and repopulate: a genuinely cold build.
# Deliberately NOT named SCCACHE_RECACHE. A build ARG is injected into
# every RUN step's environment, and sccache presence-tests that name, so
# merely declaring the ARG forces recache mode regardless of its value.
ARG FORCE_RECACHE=false
# Empty means "derive from the node"; set it to pin a job count. Unset,
# PyTorch's build uses every core, which OOMs a memory-light node the
# same way triton did.
ARG MAX_JOBS=
# Memory budget per compile job, used to derive MAX_JOBS. 2GB is
# measured for cc1plus: triton died at 32 jobs on a 30GB node.
ARG MEM_PER_JOB_GB=2
# See Dockerfile.triton: raise to debug for one run to find out what
# sccache's "Cache errors" counter is actually counting.
ARG SCCACHE_LOG=warn

# sccache on S3, for builds that are not on the fleet. Empty selects
# the WebDAV store above: sccache treats an empty SCCACHE_BUCKET as
# unset, so these are inert on SNOC. Credentials are NOT args — they
# arrive as a BuildKit secret, so they stay out of image history.
ARG SCCACHE_BUCKET=
ARG SCCACHE_REGION=
ARG SCCACHE_S3_KEY_PREFIX=rocm-pytorch

ENV SCCACHE_WEBDAV_ENDPOINT=${SCCACHE_WEBDAV_ENDPOINT} \
    SCCACHE_BUCKET=${SCCACHE_BUCKET} \
    SCCACHE_REGION=${SCCACHE_REGION} \
    SCCACHE_S3_KEY_PREFIX=${SCCACHE_S3_KEY_PREFIX} \
    SCCACHE_SERVER_UDS=/tmp/sccache.sock \
    SCCACHE_WEBDAV_KEY_PREFIX=${SCCACHE_WEBDAV_KEY_PREFIX} \
    SCCACHE_IGNORE_CLIENT_VERSION=1 \
    SCCACHE_CONF=/etc/sccache.toml \
    SCCACHE_ERROR_LOG=/tmp/sccache-err.log \
    SCCACHE_LOG=${SCCACHE_LOG} \
    CMAKE_C_COMPILER_LAUNCHER=sccache \
    CMAKE_CXX_COMPILER_LAUNCHER=sccache \
    CMAKE_HIP_COMPILER_LAUNCHER=sccache

# hipcc's launcher hook: CMAKE_*_COMPILER_LAUNCHER only covers
# CMake-driven compiles, and parts of this build call hipcc
# directly. See Dockerfile.aiter for the full reasoning.
ENV HIP_CLANG_LAUNCHER=/usr/local/bin/sccache

# Each RUN is a fresh container, so the compile step has to start its
# own sccache server, and startup probes the remote store. That probe is
# bounded by a 10s timeout compiled into sccache — there is no
# environment variable for it, only this config file field. 10s was not
# enough while the node hosting the cache was saturated: the preflight
# below passed, then the build died 21s in with "Timed out waiting for
# server startup", failing cmake's compiler test and the whole build.
#
# The backend stays configured by environment; this file carries only
# the timeout.
RUN printf 'server_startup_timeout_ms = 60000\n' > /etc/sccache.toml

# Fail early and loudly rather than spending an hour rebuilding PyTorch
# against a cache that silently is not there.
ARG REQUIRE_SCCACHE=1
# sccache reads its credentials from the environment. On the fleet
# there is no secret and the WebDAV store needs none; on S3 this is
# the only way they reach the RUN sandbox, which has no ~/.aws and
# cannot route to the container credential endpoint. The secret is a
# tmpfs file for the life of this instruction, so it never lands in
# image history or a published layer.
RUN --mount=type=secret,id=aws,required=false \
    if [ -s /run/secrets/aws ]; then set -a; . /run/secrets/aws; set +a; fi; \
    if [ -n "${SCCACHE_BUCKET}" ]; then \
        store="s3://${SCCACHE_BUCKET} (${SCCACHE_REGION})"; \
    else \
        store="${SCCACHE_WEBDAV_ENDPOINT}"; \
    fi; \
    if sccache --show-stats > /dev/null 2>&1; then \
        echo "sccache: server up, cache = ${store}"; \
    elif [ "${REQUIRE_SCCACHE}" = "1" ]; then \
        echo "ERROR: sccache could not reach ${store}." >&2; \
        if [ -n "${SCCACHE_BUCKET}" ]; then \
            echo "  The S3 backend is selected. Check that the build was" >&2; \
            echo "  given --secret id=aws carrying AWS_ACCESS_KEY_ID," >&2; \
            echo "  AWS_SECRET_ACCESS_KEY and, for session credentials," >&2; \
            echo "  AWS_SESSION_TOKEN; and that the policy grants" >&2; \
            echo "  s3:ListBucket as well as Get/PutObject — without it" >&2; \
            echo "  a missing key returns 403 rather than 404 and this" >&2; \
            echo "  probe fails for the wrong reason." >&2; \
        else \
            echo "  Check nginx on Strix (sccache-webdav site), and that this" >&2; \
            echo "  builder was created with --driver-opt network=host." >&2; \
        fi; \
        echo "  Build anyway with --set '*.args.REQUIRE_SCCACHE=0'." >&2; \
        exit 1; \
    else \
        echo "WARNING: no sccache cache; this build will not be cached." >&2; \
    fi

# ─── Build configuration ─────────────────────────────────────────
# gfx950 is CDNA-class (MI350 series). The arch is selected by
# PYTORCH_ROCM_ARCH alone; a ";"-separated list produces a fat binary.

# Optional libraries — control via bake variables or build args
ENV USE_AITER=${USE_AITER} \
    USE_FLYDSL=${USE_FLYDSL} \
    USE_FLASH_ATTENTION=${USE_FLASH_ATTENTION} \
    USE_ROCM_CK_SDPA_GFX12=${USE_ROCM_CK_SDPA_GFX12}

# CMAKE_CUDA_ARCHITECTURES="ROCM" and CMAKE_CXX_FLAGS="-march=gfx950"
# are both gone. -march/-mtune are host-CPU flags: gfx950 is a GPU
# target, so every host compile would have failed on an unrecognised
# -march value. The GPU architecture is selected by PYTORCH_ROCM_ARCH
# alone, which upstream documents as the supported mechanism.
# PyTorch pulls cmake 4.x from pip, which dropped compatibility with
# cmake_minimum_required(<3.5). Several vendored deps (confu/NNPACK and
# friends) still declare it, and fail to configure without this.
ENV CMAKE_POLICY_VERSION_MINIMUM=3.5

# USE_NCCL=ON means RCCL here, and it is not optional for every
# consumer of this image.
#
# It was OFF until now, and that was never a decision about collectives
# — it arrived inside this block in commit 48b0307 ("tidy the top
# level"), whose message does not mention NCCL or RCCL. Nothing noticed
# because nothing exercised torch.distributed: vLLM at TP=1 needs no
# process group, so the whole pipeline ran for weeks on a torch with
# only gloo.
#
# ATOM is what found it. Its model runner creates a process group even
# at -tp 1, so `python -m atom.entrypoints.openai_server` died with
#
#     RuntimeError: Distributed package doesn't have NCCL built in
#
# on a card AITER had already JIT-compiled for happily. Not an
# architecture problem and not an ATOM bug — this flag.
#
# No USE_SYSTEM_NCCL beside it, deliberately: cmake/Dependencies.cmake
# logs "Forcing USE_SYSTEM_NCCL to ON since it's required by using
# RCCL" and includes External/rccl.cmake itself, so setting it here
# would restate what upstream already guarantees.
#
# Nothing has to be fetched or built for this. ROCm 10.1 ships RCCL
# complete — NCCL API 2.30.7, amdrocm-rccl-dev10.1 carrying
# rccl/rccl.h and lib/cmake/rccl/rccl-config.cmake — and rocm-prune
# keeps the arch-scoped amdrocm-rccl10.1-gfxNNNN through its generic
# -gfxNNNN rule, so the runtime library survives into every image
# downstream. Contrast UCX in Dockerfile.nixl, which IS built from
# source because Ubuntu's has no ROCm support; RCCL has no such gap.
ENV USE_ROCM=1 \
    USE_CUDA=0 \
    USE_MKLDNN=OFF \
    USE_NCCL=ON \
    USE_KINETO=OFF \
    USE_FBGEMM=ON \
    USE_QNNPACK=ON \
    BUILD_TEST=OFF \
    BUILD_BINARY=OFF \
    BUILD_SHARED_LIBS=ON \
    CMAKE_BUILD_TYPE=Release

# ROCm specific build flags
# HIP_ARCHITECTURES set via PYTORCH_ROCM_ARCH (default gfx950, override with semicolon-separated list)
# Example: PYTORCH_ROCM_ARCH="gfx90a;gfx942;gfx1100"
# ROCM_PATH is what the build system reads (ROCM_HOME is kept as the
# older alias). PYTORCH_ROCM_ARCH is the documented way to pin the GPU
# target; the build detects it automatically when unset.
ENV ROCM_PATH=/opt/rocm \
    ROCM_HOME=/opt/rocm \
    PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH} \
    USE_SYSTEM_NCCL=OFF \
    CMAKE_PREFIX_PATH=/opt/venv

# ─── Build requirements ──────────────────────────────────────────
# Upstream's documented dependency install for 2.14 is the PEP 735 dev
# group, not requirements.txt. --no-isolation means pip will not fetch
# the build backend itself, so it has to be here too.
RUN pip install --no-cache-dir build && \
    pip install --no-cache-dir --group dev && \
    pip install --no-cache-dir mkl-static mkl-include

# ─── Hipify for ROCm ─────────────────────────────────────────────
# Upstream: "If you're compiling for AMD ROCm then first run this
# command". It rewrites CUDA sources to HIP in place; without it the
# build compiles the CUDA paths and fails.
RUN python tools/amd_build/build_amd.py

# ─── Build PyTorch ───────────────────────────────────────────────
# pipefail matters: without it the RUN takes tee's exit status, so a
# failed compile reports success and only surfaces as a confusing empty
# dist/ one step later.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# PyTorch 2.14 dropped `setup.py bdist_wheel`: the build moved to
# scikit-build-core behind the standard PEP 517 interface, and setup.py
# now refuses every command except install/develop. --no-isolation keeps
# the build in this environment so it sees ROCm, the pinned Python and
# the sccache launchers; it means the build requirements have to be
# present already, which the previous step installs.
# SCCACHE_RECACHE must be set ONLY when a forced recache is wanted.
# sccache checks presence, never value:
#     let force_recache = env_vars.iter().any(|(k, _v)| k == "SCCACHE_RECACHE");
# so SCCACHE_RECACHE=false enables it exactly as =true does. Exporting it
# unconditionally put every build in write-only mode — sccache never read
# the cache, so no build could ever hit.
# sccache reads its credentials from the environment. On the fleet
# there is no secret and the WebDAV store needs none; on S3 this is
# the only way they reach the RUN sandbox, which has no ~/.aws and
# cannot route to the container credential endpoint. The secret is a
# tmpfs file for the life of this instruction, so it never lands in
# image history or a published layer.
#
# PYTORCH_BUILD_VERSION marks the wheel as a ROCm build. It is assembled
# here rather than left to tools/generate_torch_version.py because that
# file's default stops at version.txt + the sha:
#
#     version = Path(pytorch_root / "version.txt").read_text().strip()
#     if sdist_version is None and sha != UNKNOWN:
#         version += "+git" + sha[:7]
#
# so the same two inputs are reproduced here and ".rocm<ver>" appended,
# keeping the commit visible: 2.15.0a0+git31a77fc.rocm10.1.0. A leading
# dot, not a plus -- a version carries at most one local segment, and
# "+git" has already opened it.
#
# PYTORCH_BUILD_NUMBER is not optional. The same file raises
# AssertionError when PYTORCH_BUILD_VERSION is set without it, and a
# number above 1 would append a .postN nobody asked for.
RUN --mount=type=secret,id=aws,required=false \
    if [ -s /run/secrets/aws ]; then set -a; . /run/secrets/aws; set +a; fi; \
    tv=$(tr -d '[:space:]' < version.txt); \
    sha=$(git rev-parse HEAD | cut -c1-7); \
    [ -n "${tv}" ] || { echo "version.txt is empty" >&2; exit 1; }; \
    [ -n "${sha}" ] || { echo "git rev-parse produced no sha" >&2; exit 1; }; \
    export PYTORCH_BUILD_VERSION="${tv}+git${sha}.rocm${ROCM_VERSION%%-*}"; \
    export PYTORCH_BUILD_NUMBER=1; \
    echo "PYTORCH_BUILD_VERSION=${PYTORCH_BUILD_VERSION}"; \
    if [ "${FORCE_RECACHE}" = "true" ] || [ "${FORCE_RECACHE}" = "1" ]; then \
        export SCCACHE_RECACHE=1; \
        echo "sccache: forced recache ON — cache reads disabled for this build"; \
    else \
        echo "sccache: normal mode — cache reads enabled"; \
    fi; \
    if [ -z "${MAX_JOBS}" ]; then \
        cores=$(nproc); \
        jobs=$(awk -v per="${MEM_PER_JOB_GB}" '/^MemAvailable:/ {print int($2/1024/1024/per)}' /proc/meminfo); \
        [ -n "${jobs}" ] || jobs=${cores}; \
        [ "${jobs}" -ge 1 ] || jobs=1; \
        [ "${jobs}" -le "${cores}" ] || jobs=${cores}; \
        export MAX_JOBS=${jobs}; \
        echo "MAX_JOBS=${MAX_JOBS} (from ${cores} cores, $(awk '/^MemAvailable:/ {printf "%.0fGB", $2/1048576}' /proc/meminfo) available)"; \
    else \
        echo "MAX_JOBS=${MAX_JOBS} (pinned via build arg)"; \
    fi; \
    python -m build --wheel --no-isolation \
    --outdir /opt/pytorch/dist \
    2>&1 | tee /opt/pytorch/build.log \
    && sccache --show-stats | tee /opt/pytorch/sccache-stats.txt; rc=$?; echo "--- sccache error log: $(wc -c < /tmp/sccache-err.log 2>/dev/null || echo absent) bytes ---"; grep -aiE 'cache error|preprocessor failed|cache read error|cache write error|failed to (read|write)' /tmp/sccache-err.log 2>/dev/null | grep -v 'read failed NotFound' | head -60; echo "--- cache misses, first 40 (debug only) ---"; grep -aoE '\[[^]]+\]: Cache miss' /tmp/sccache-err.log 2>/dev/null | head -40; exit $rc

SHELL ["/bin/sh", "-c"]

# Verify the wheel was built
RUN ls -la /opt/pytorch/dist/

# No auditwheel step here, unlike Dockerfile.lmcache and
# Dockerfile.cupy, and the reason is measured rather than assumed. This
# wheel references GLIBC_2.43 from libm -- the base image's glibc is
# newer than any manylinux policy auditwheel knows -- so `auditwheel
# show` ends with
#
#     This constrains the platform tag to "linux_x86_64".
#
# No exclude list changes that: the symbol is in torch's own code, not
# in a dependency that could be left to the consuming image. Repairing
# the wheel would vendor libraries and rewrite RPATHs for no change of
# tag, on the largest artifact here. Measured 2026-11-06 against the
# published gfx950 wheel.
#
# The suffix must have reached the wheel. PYTORCH_BUILD_VERSION is read
# at the start of a 45-minute build; discovering at publish time that it
# was empty means doing all of it again.
#
# The expected name is recomputed from the same two inputs rather than
# pattern-matched loosely. A glob like *"+git"*".rocm10.1.0-"* looks
# strict and is not: it happily matches "torch-2.15.0a0+git.rocm10.1.0",
# the exact output of a build whose `git rev-parse` produced nothing.
RUN set -eu; \
    tv=$(tr -d '[:space:]' < version.txt); \
    sha=$(git rev-parse HEAD | cut -c1-7); \
    [ -n "${tv}" ] && [ -n "${sha}" ] || { \
        echo "cannot recompute expected version" >&2; exit 1; }; \
    want="torch-${tv}+git${sha}.rocm${ROCM_VERSION%%-*}-"; \
    found=$(find /opt/pytorch/dist -maxdepth 1 -name 'torch-*.whl' | head -1); \
    [ -n "${found}" ] || { echo "no torch wheel in dist/" >&2; exit 1; }; \
    case "$(basename "${found}")" in \
        "${want}"*) echo "version ok: $(basename "${found}")" ;; \
        *) echo "torch wheel is $(basename "${found}")," \
                "expected ${want}*" >&2; exit 1 ;; \
    esac

# ─── Test stage (optional, run with --target pytorch-test) ───────
FROM builder AS test

RUN python -c "\
import torch; \
print(f'PyTorch version: {torch.__version__}'); \
print(f'HIP available: {torch.version.hip}'); \
print(f'HIP runtime: {torch.cuda.is_available()}'); \
if torch.cuda.is_available(): \
    print(f'Device count: {torch.cuda.device_count()}'); \
    for i in range(torch.cuda.device_count()): \
        print(f'Device {i}: {torch.cuda.get_device_name(i)}'); \
        print(f'  HIP Compute Unit: {torch.cuda.get_device_properties(i).total_memory / 1e9:.1f}GB'); \
        print(f'  HIP Compute Capability: {torch.cuda.get_device_capability(i)}'); \
else: \
    print('ERROR: CUDA/HIP not available!'); \
    exit(1)"

# ─── Final PyTorch image ─────────────────────────────────────────
FROM ${BASE_IMAGE} AS final

ARG PYTORCH_VERSION
ARG ROCM_VERSION
ARG PYTORCH_ROCM_ARCH

LABEL org.opencontainers.image.source="https://github.com/sbates130272/rocm-pytorch-build"
LABEL org.opencontainers.image.description="PyTorch ${PYTORCH_VERSION} for ${PYTORCH_ROCM_ARCH}, ROCm ${ROCM_VERSION}"

# Build records, kept so timing and cache-hit data survive the build
# stage being discarded. `make build-report` reads sccache-stats.txt.
#
# From torchwheels, not builder: the wheel stage already publishes both
# of these at its root, so nothing is lost by sourcing them here, and
# referencing builder would pull the whole compile back into this
# target. Same for the dist below — those two COPYs were the only
# thing tying `final` to `builder`.
COPY --from=torchwheels /build.log /sccache-stats.txt /var/log/pytorch-build/

# A bind mount, not a COPY. This used to `COPY --from=torchwheels` into
# /opt/pytorch/dist, install from there and `rm -rf /opt/pytorch` a few
# lines down — and a COPY is a layer, so the delete reclaimed nothing
# and every pull of this image paid for a 0.40 GB torch wheel it could
# not use. Mounted, the wheel exists only for the duration of the RUN
# and never becomes a layer at all.
#
# Nothing is lost by that: `pytorch-wheel` publishes the same wheel as
# its own scratch image, which is where the artifact is meant to be
# recovered from, and `make fetch-torch-wheel` already reads it there.
#
# The torch install must be able to fail the build. Previously a
# trailing `|| true` covered this chain, so when the glob did not expand
# and pip errored with "Invalid wheel filename ... '*'", the image was
# published without PyTorch in it.
RUN --mount=type=bind,from=torchwheels,source=/wheels,target=/wheels \
    pip install --no-cache-dir /wheels/*.whl \
    && python -c "import torch; print('installed torch', torch.__version__)"

# torchaudio, torchdata and torchvision are deliberately NOT installed.
#
# PyPI publishes them as CUDA builds, and they were the only thing in
# this image that was. This step shipped several hundred MB of unusable
# code, and did it under `|| true`, which is what kept the breakage
# quiet.
#
# torchvision has since been answered properly: docker/Dockerfile.torchvision
# builds it against this torch and Dockerfile.vllm installs that wheel,
# which is what let vLLM's LMCache connector import check be restored.
# It is still not installed *here*, and cannot be: torchvision-wheel
# builds FROM this image, so installing it would be a cycle. Anything
# that needs torchvision takes the wheel as a context, the way vllm
# does.
#
# torchaudio and torchdata have no such target and nothing in this
# stack imports them. Give them one the same way if that changes;
# do not restore the PyPI install.

# Triton, from our own wheel rather than PyPI. A source-built torch
# wheel declares no triton dependency — upstream's published ROCm
# wheels list pytorch-triton-rocm in Requires-Dist, but that is added
# by their release packaging, not by the build — so `pip install torch`
# pulls nothing and torch.compile fails with "Cannot find a working
# triton installation". AMD's published triton also stops at ROCm 7.2,
# which is why we build our own.
#
# --no-deps: the wheel's own dependencies are already satisfied, and
# letting pip resolve them here risks pulling a CUDA torch from PyPI.
#
# Mounted rather than copied, for the reason above: the COPY this
# replaces left a 0.45 GB triton wheel in the image, and the `rm -rf`
# that followed it in the same RUN deleted a path in a layer that had
# already been committed.
RUN --mount=type=bind,from=tritonwheels,source=/wheels,target=/triton-wheels \
    pip install --no-cache-dir --no-deps /triton-wheels/*.whl \
    && python -c "import triton; print('installed triton', triton.__version__)"

# ROCm runtime config
ENV ROCM_PATH=/opt/rocm
ENV PATH=${ROCM_PATH}/bin:${ROCM_PATH}/hip/bin:${PATH}
ENV LD_LIBRARY_PATH=${ROCM_PATH}/lib:/opt/rocm/lib:$LD_LIBRARY_PATH
# No HSA_OVERRIDE_GFX_VERSION. It used to be pinned to 11.0.2 here,
# which tells HSA to treat whatever GPU it finds as gfx1102 (RDNA3).
# That is a workaround for running on a GPU with no native support, and
# it is actively harmful everywhere else: on a real gfx1201 it made HSA
# fail at init with "HSA_STATUS_ERROR_OUT_OF_RESOURCES" and
# hipGetDeviceCount returning hipErrorNoDevice, so torch saw no device
# at all. Removing it, the same image reports
# "AMD Radeon RX 9070 XT gfx1201" and runs a correct matmul.
#
# If a specific host ever needs the override, set it per-run
# (docker run -e HSA_OVERRIDE_GFX_VERSION=...) rather than baking it
# into every image.

# Test entrypoint
CMD ["python", "-c", "import torch; print(f'PyTorch {torch.__version__} HIP:{torch.version.hip}'); print(f'Devices: {torch.cuda.device_count() if torch.cuda.is_available() else 0}'); print(f'GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"N/A\"}'); import sys; sys.exit(0 if torch.cuda.is_available() else 1)"]

ENTRYPOINT ["python"]

# ─── Wheel-only image ────────────────────────────────────────────
# The final image installs the wheel into /opt/venv and then deletes
# it, so the artifact that took half an hour to produce cannot be
# recovered from it. This stage publishes the wheel itself: a scratch
# image carrying nothing but /wheels, which buildx can push to Zot and
# `COPY --from=` can consume, with no extra artifact store.
#
# Build it with `--target wheel` (bake target: pytorch-wheel). The
# builder stage is shared, so with a warm layer cache this costs a
# copy rather than a rebuild.
FROM scratch AS wheel

COPY --from=builder /opt/pytorch/dist/ /wheels/
COPY --from=builder /opt/pytorch/build.log /opt/pytorch/sccache-stats.txt /
